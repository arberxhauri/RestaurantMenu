# /srv/.env on the server (chmod 600): variables docker-compose.yml itself uses. Never commit it.
# Shared by the whole server (other sites' keys live here too); no container reads this file.
# The app's own settings are in mqm.env (see mqm.env.example).

# openssl rand -hex 24
MQM_DB_PASSWORD=
# Let's Encrypt account email (expiry warnings)
ACME_EMAIL=
