# /srv/mqm.env on the server (chmod 600): the app's settings. Never commit the real file.
# Values here stay empty on purpose. Copy the ones that are set on Render (Environment tab).
# docker-compose.yml sets ASPNETCORE_*, DOTNET_gcServer, DISK_MOUNT_PATH, DataProtection__KeysPath and
# ConnectionStrings__DefaultConnection itself: do NOT copy those from Render.

# --- Addresses ---
# https://myquickmenu.com
Seo__BaseUrl=
# myquickmenu.com (free {restaurant}.myquickmenu.com sites)
Sites__WildcardDomain=
# DNS instructions shown to restaurants for their own domains:
# 138.199.131.201 (A record of a root domain)
Sites__ApexIp=
# myquickmenu.com (CNAME target of www./sub-domains)
Sites__CnameTarget=
# Do NOT copy Sites__RenderApiKey / Sites__RenderServiceId: they register domains with Render.

# --- Email: Email__From plus one provider ---
Email__Provider=
Email__From=
Email__FromName=
Email__ReplyTo=
Email__ResendApiKey=
Email__BrevoApiKey=
Smtp__Host=
Smtp__Port=
Smtp__User=
Smtp__Password=
Smtp__From=

# --- Billing (Paddle) ---
Billing__Paddle__Environment=
Billing__Paddle__ApiKey=
Billing__Paddle__WebhookSecret=
Billing__Paddle__ClientToken=

# --- Signup ---
Signup__NotifyEmail=

# --- SMS (optional) ---
Sms__Provider=
Sms__TwilioAccountSid=
Sms__TwilioAuthToken=
Sms__TwilioFrom=
Sms__WebhookUrl=
Sms__WebhookToken=

# --- Translate-assist (Gemini) ---
Translation__GeminiApiKey=

# --- Anything else set on Render that isn't listed (e.g. Brand__*, Billing__Prices__*, rate limits) ---
