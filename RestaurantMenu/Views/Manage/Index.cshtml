@using System.Globalization
@using RestaurantMenu.Controllers
@model List<BranchOverview>
@{
    ViewData["Title"] = "Overview";
    var en = CultureInfo.GetCultureInfo("en-GB");
    string Money(string cur, decimal v) => cur + v.ToString("N0", en);
    string Delta(decimal now, decimal before) => before == 0 ? (now == 0 ? "No change" : "New sales") : $"{(now - before) / before:P0} vs last week";
    // Never add different currencies together: one total per currency.
    var byCurrency = Model.GroupBy(r => r.CurrencyCode).ToList();
}

<header class="page-head">
    <div>
        <h1>Overview</h1>
        <p>Sales, live service, bookings and alerts across @(Model.Count == 1 ? "your branch" : $"your {Model.Count} branches").</p>
    </div>
</header>

@if (Model.Count == 0)
{
    <section class="panel"><div class="empty">
        <i class="ph ph-chart-line-up" aria-hidden="true"></i>
        <h2>Nothing to show yet</h2>
        <p>The overview covers branches you own or manage.</p>
    </div></section>
}
else
{
    @foreach (var g in byCurrency)
    {
        var cur = g.First().Currency;
        var todayRevenue = g.Sum(r => r.Today.Revenue);
        var lastWeekRevenue = g.Sum(r => r.SameWeekdayLastWeek.Revenue);
        var todayOrders = g.Sum(r => r.Today.Orders);
        <div class="kpi-row">
            <div class="kpi"><span class="kpi-label">Sales today@(byCurrency.Count > 1 ? $" ({g.Key})" : "")</span><span class="kpi-value">@Money(cur, todayRevenue)</span><span class="kpi-delta kpi-delta--flat"><span>@Delta(todayRevenue, lastWeekRevenue)</span></span></div>
            <div class="kpi"><span class="kpi-label">Orders</span><span class="kpi-value">@todayOrders</span><span class="kpi-delta kpi-delta--flat"><span>Avg. @(todayOrders == 0 ? Money(cur, 0) : Money(cur, todayRevenue / todayOrders))</span></span></div>
            @if (g.Any(r => r.HasOrdering)) { <div class="kpi"><span class="kpi-label">Tables in use</span><span class="kpi-value">@g.Where(r => r.HasOrdering).Sum(r => r.TablesInUse)</span><span class="kpi-delta kpi-delta--flat"><span>@g.Where(r => r.HasOrdering).Sum(r => r.LiveOrders) open tickets</span></span></div> }
            @if (g.Any(r => r.HasBookings)) { <div class="kpi"><span class="kpi-label">Bookings today</span><span class="kpi-value">@g.Where(r => r.HasBookings).Sum(r => r.BookingsToday)</span><span class="kpi-delta kpi-delta--flat"><span>@g.Where(r => r.HasBookings).Sum(r => r.CoversToday) covers</span></span></div> }
        </div>
    }

    <section class="panel mb-4" aria-labelledby="liveTitle">
        <header class="panel-head"><div><h2 id="liveTitle">Live service</h2><p>What needs attention right now.</p></div></header>
        <div class="panel-body"><div class="row g-3">
            @foreach (var r in Model)
            {
                <div class="col-12 col-xl-6"><article class="card h-100"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3"><div><h3 class="h5 mb-1">@r.Branch.Name</h3>@if (r.HasOrdering) { <p class="text-muted mb-3">@r.LiveOrders open tickets@(r.OldestTicket is { } age ? $" · oldest {Math.Max(1, (int)age.TotalMinutes)} min" : "")</p> }</div>@if (r.HasOrdering) { <span class="chip @(r.LiveOrders > 0 ? "chip--warn" : "chip--ok")">@(r.LiveOrders > 0 ? "In service" : "Clear")</span> }</div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (r.HasManagement && r.LowStock.Count > 0) { <span class="chip chip--warn"><i class="ph ph-package" aria-hidden="true"></i>@r.LowStock.Count low stock</span> }
                        @if (r.UnavailableItems > 0) { <span class="chip chip--warn"><i class="ph ph-eye-slash" aria-hidden="true"></i>@r.UnavailableItems unavailable</span> }
                        @if (r.LowRatings > 0) { <span class="chip chip--danger"><i class="ph ph-star" aria-hidden="true"></i>@r.LowRatings low ratings</span> }
                        @if ((!r.HasManagement || r.LowStock.Count == 0) && r.UnavailableItems == 0 && r.LowRatings == 0) { <span class="text-muted">No active alerts.</span> }
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        @if (r.HasOrdering) { <a class="btn btn-primary btn-sm" asp-controller="Kitchen" asp-action="Index" asp-route-id="@r.Branch.Id"><i class="ph ph-cooking-pot" aria-hidden="true"></i>Open kitchen</a> }
                        @if (r.HasBookings) { <a class="btn btn-outline-secondary btn-sm" asp-controller="Bookings" asp-action="Index" asp-route-id="@r.Branch.Id"><i class="ph ph-calendar-plus" aria-hidden="true"></i>Add booking</a> }
                        @if (r.HasManagement) { <a class="btn btn-outline-secondary btn-sm" asp-controller="Stock" asp-action="Index" asp-route-id="@r.Branch.Id"><i class="ph ph-package" aria-hidden="true"></i>Stock delivery</a> }
                    </div>
                </div></article></div>
            }
        </div></div>
    </section>

    @foreach (var r in Model)
    {
        var max14 = Math.Max(1m, r.Last14.Max(d => d.Revenue));
        <section class="panel mb-4" aria-labelledby="trend-@r.Branch.Id">
            <header class="panel-head"><div><h2 id="trend-@r.Branch.Id">@r.Branch.Name · last 14 days</h2><p>Daily sales, including today so far.</p></div></header>
            <div class="panel-body"><div class="dashboard-bars" role="img" aria-label="Sales for the last fourteen days">
                @foreach (var d in r.Last14)
                {
                    var height = (double)(d.Revenue / max14);
                    <div class="dashboard-bar" title="@d.Date.ToString("dd MMM"): @Money(r.Currency, d.Revenue)"><span style="--h:@height.ToString("0.####", CultureInfo.InvariantCulture)"></span><small>@d.Date.ToString("dd")</small></div>
                }
            </div></div>
        </section>
    }

    <section class="panel mb-4" aria-labelledby="branchesTitle">
        <header class="panel-head"><h2 id="branchesTitle">Branches</h2></header>
        <div class="table-responsive">
            <table class="data-table ov-table">
                <thead>
                    <tr>
                        <th scope="col">Branch</th>
                        <th scope="col" class="text-end">Today</th>
                        <th scope="col" class="text-end">Yesterday</th>
                        <th scope="col" class="text-end">7 days</th>
                        <th scope="col" class="text-end">30 days</th>
                        <th scope="col">Stock</th>
                        <th scope="col">On shift now</th>
                        <th scope="col"><span class="visually-hidden">Open</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <th scope="row">
                                <a asp-controller="Branch" asp-action="Details" asp-route-id="@r.Branch.Id">@r.Branch.Name</a>
                                @if (r.Unclosed > 0) { <span class="chip chip--warn" title="Days with orders but no closing count, last 7 days"><i class="ph ph-lock-open" aria-hidden="true"></i>@r.Unclosed not closed</span> }
                            </th>
                            <td class="text-end tabular">@Money(r.Currency, r.Today.Revenue)</td>
                            <td class="text-end tabular">@Money(r.Currency, r.Yesterday.Revenue)</td>
                            <td class="text-end tabular">@Money(r.Currency, r.Last7)</td>
                            <td class="text-end tabular">@Money(r.Currency, r.Last30)</td>
                            <td>
                                @if (r.LowStock.Count == 0) { <span class="text-muted">OK</span> }
                                else { <a class="chip chip--warn chip--link" asp-controller="Stock" asp-action="Index" asp-route-id="@r.Branch.Id" title="@string.Join(", ", r.LowStock)"><i class="ph ph-warning" aria-hidden="true"></i>@r.LowStock.Count low</a> }
                            </td>
                            <td>@(r.OnShift.Count == 0 ? "—" : string.Join(", ", r.OnShift))</td>
                            <td class="text-end text-nowrap">
                                @if (r.HasManagement)
                                {
                                    <a class="icon-btn" asp-controller="Sales" asp-action="Index" asp-route-id="@r.Branch.Id" aria-label="Sales of @r.Branch.Name" title="Sales"><i class="ph ph-receipt" aria-hidden="true"></i></a>
                                    <a class="icon-btn" asp-controller="Stock" asp-action="Index" asp-route-id="@r.Branch.Id" aria-label="Stock of @r.Branch.Name" title="Stock"><i class="ph ph-package" aria-hidden="true"></i></a>
                                    <a class="icon-btn" asp-controller="Shifts" asp-action="Index" asp-route-id="@r.Branch.Id" aria-label="Shifts of @r.Branch.Name" title="Shifts"><i class="ph ph-calendar-blank" aria-hidden="true"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @foreach (var g in byCurrency.Where(g => g.Count() > 1))
    {
        var max = g.Max(r => r.Last30);
        <section class="panel" aria-labelledby="share@(g.Key)">
            <header class="panel-head"><h2 id="share@(g.Key)">Last 30 days by branch@(byCurrency.Count > 1 ? $" ({g.Key})" : "")</h2></header>
            <div class="panel-body">
                <ul class="lang-bars">
                    @foreach (var r in g.OrderByDescending(r => r.Last30))
                    {
                        var w = max == 0 ? 0 : (double)(r.Last30 / max);
                        <li>
                            <span class="lang-bars-name">@r.Branch.Name</span>
                            <span class="hbar" aria-hidden="true"><span class="hbar-fill" style="--w: @w.ToString("0.####", CultureInfo.InvariantCulture)"></span></span>
                            <span class="lang-bars-count tabular">@Money(r.Currency, r.Last30)</span>
                        </li>
                    }
                </ul>
            </div>
        </section>
    }
}
