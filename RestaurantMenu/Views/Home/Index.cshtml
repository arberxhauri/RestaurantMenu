    <section id="features" class="band band-both">
        <div class="band-inner">
            <div class="section-head" style="margin-bottom:56px">
                <div class="kicker">Features</div>
                <h2>Shared across every product</h2>
                <p>
                    Built for the way restaurants actually work — mid-service edits, seasonal swaps, and guests
                    who speak four languages.
                </p>
            </div>
            <div class="feature-grid">
                <div class="feature-card">
                    <svg width="30" height="30" viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="18" cy="24" r="14" stroke="#231813" stroke-width="4"></circle><circle cx="32" cy="24" r="14" stroke="#D55C13" stroke-width="4"></circle></svg>
                    <div class="feature-title">Multilingual support</div>
                    <div class="feature-desc">Serve international guests in their own language. They switch in one tap; you write it once.</div>
                </div>
                <div class="feature-card">
                    <svg width="30" height="30" viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="14" y="4" width="20" height="40" rx="6" stroke="#231813" stroke-width="4"></rect><circle cx="24" cy="36" r="3.5" fill="#D55C13"></circle></svg>
                    <div class="feature-title">Mobile optimised</div>
                    <div class="feature-desc">Menus built phone-first — legible in low light, thumb-reachable, and fast on café wifi.</div>
                </div>
                <div class="feature-card">
                    <svg width="30" height="30" viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="24" r="18" stroke="#231813" stroke-width="4"></circle><circle cx="24" cy="24" r="6" fill="#D55C13"></circle></svg>
                    <div class="feature-title">Real-time updates</div>
                    <div class="feature-desc">Sold out at 19:40? Hide it. The change is on every table before the next order lands.</div>
                </div>
                <div class="feature-card">
                    <svg width="30" height="30" viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="4" y="4" width="18" height="18" rx="6" fill="#231813"></rect><rect x="26" y="26" width="18" height="18" rx="6" fill="#D55C13"></rect><rect x="26" y="4" width="18" height="18" rx="6" stroke="#231813" stroke-width="4"></rect></svg>
                    <div class="feature-title">Custom branding</div>
                    <div class="feature-desc">Your colours, your logo, your banner. The menu looks like your room, not like software.</div>
                </div>
                <div class="feature-card">
                    <svg width="30" height="30" viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="4" y="10" width="40" height="7" rx="3.5" fill="#231813"></rect><rect x="4" y="22" width="28" height="7" rx="3.5" fill="#231813"></rect><rect x="4" y="34" width="16" height="7" rx="3.5" fill="#D55C13"></rect></svg>
                    <div class="feature-title">Easy management</div>
                    <div class="feature-desc">Branches, categories and dishes in one dashboard. Drag to reorder — no training needed.</div>
                </div>
                <div class="feature-card">
                    <svg width="30" height="30" viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="6" y="6" width="36" height="36" rx="11" stroke="#231813" stroke-width="4"></rect><circle cx="24" cy="24" r="6" fill="#D55C13"></circle></svg>
                    <div class="feature-title">Secure &amp; reliable</div>
                    <div class="feature-desc">Enterprise-grade security and 99.9% uptime. Your menu is up when your doors are.</div>
                </div>
            </div>
        </div>
    </section>

    <section id="how-it-works" class="band-inner" style="background:transparent">
        <div class="section-head" style="margin-bottom:56px">
            <div class="kicker">How it works</div>
            <h2>Three steps to going live</h2>
        </div>
        <div class="steps">
            <div class="step">
                <div class="step-num">01</div>
                <div class="step-title">Create your branch</div>
                <div class="step-desc">Name, address, opening hours, logo and banner. Each location gets its own menu and its own link.</div>
            </div>
            <div class="step">
                <div class="step-num">02</div>
                <div class="step-title">Add your menu</div>
                <div class="step-desc">Categories, dishes, prices, photos, allergens. Paste from a spreadsheet or type it straight in.</div>
            </div>
            <div class="step">
                <div class="step-num">03</div>
                <div class="step-title">Switch on the rest</div>
                <div class="step-desc">Print the QR, publish the website, open the booking calendar. Same data, three new front doors.</div>
            </div>
        </div>
    </section>

    @if (showPartners)
    {
        <section id="partners" class="band band-both">
            <div class="partners-inner">
                <div class="partners-head">
                    <h2>Trusted by restaurants that keep changing their minds</h2>
                    <p>And their specials, and their prices, and their hours.</p>
                </div>
                <div class="partner-row">
                    @foreach (var branch in partners)
                    {
                        <a class="partner-card"
                           asp-controller="Menu"
                           asp-action="Index"
                           asp-route-branchName="@branch.Name.Replace(" ", "")"
                           target="_blank"
                           rel="noopener"
                           title="@branch.Name">
                            <img src="@branch.Logo" alt="@branch.Name" loading="lazy" />
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    <section id="cta" class="cta-inner">
        <div class="cta-panel">
            <div class="cta-copy">
                <svg width="42" height="42" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                    <rect x="4.5" y="4.5" width="15" height="15" rx="4" stroke="#FBF8F4" stroke-width="5"></rect>
                    <rect x="26" y="2" width="20" height="20" rx="6.5" fill="#FBF8F4"></rect>
                    <rect x="2" y="26" width="20" height="20" rx="6.5" fill="#FBF8F4"></rect>
                    <circle cx="36" cy="36" r="10" fill="#E68C2C"></circle>
                </svg>
                <h2>Run the whole room from one place</h2>
                <p>
                    Menus, website, bookings and back office. Start with one, add the rest whenever. Free
                    while you build it.
                </p>
            </div>
            @if (isSignedIn)
            {
                <a class="btn btn-cta" asp-controller="Dashboard" asp-action="Index">@ctaLabel</a>
            }
            else
            {
                <a class="btn btn-cta" asp-controller="Account" asp-action="Login">@ctaLabel</a>
            }
        </div>
    </section>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <svg width="26" height="26" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                    <rect x="4.5" y="4.5" width="15" height="15" rx="4" stroke="#231813" stroke-width="5"></rect>
                    <rect x="26" y="2" width="20" height="20" rx="6.5" fill="#231813"></rect>
                    <rect x="2" y="26" width="20" height="20" rx="6.5" fill="#231813"></rect>
                    <circle cx="36" cy="36" r="10" fill="#D55C13"></circle>
                </svg>
                <span class="footer-word">myquick<em>menu</em></span>
                <span class="footer-tag">Menus, websites &amp; bookings</span>
            </div>
            <div class="footer-links">
                <a href="#products">Products</a>
                <a href="#features">Features</a>
                @if (showPartners)
                {
                    <a href="#partners">Partners</a>
                }
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a asp-controller="Home" asp-action="Privacy">Terms</a>
                <span>&copy; @DateTime.Now.Year My Quick Menu</span>
            </div>
        </div>
    </footer>

    <script>
        (function () {
            var toggle = document.getElementById('navToggle');
            var nav = document.getElementById('primaryNav');
            if (!toggle || !nav) return;

            toggle.addEventListener('click', function () {
                var open = nav.classList.toggle('is-open');
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            });

            nav.addEventListener('click', function (e) {
                if (e.target.tagName === 'A') {
                    nav.classList.remove('is-open');
                    toggle.setAttribute('aria-expanded', 'false');
                }
            });
        })();
    </script>
</body>
</html>
