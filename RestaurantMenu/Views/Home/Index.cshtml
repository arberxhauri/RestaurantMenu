                        </div>
                        <div class="tag-row">
                            <span class="tag">Orders &amp; tables</span>
                            <span class="tag">Stock</span>
                            <span class="tag">Staff roles</span>
                        </div>
                    </div>
                    <div class="product-figure">
                        <div class="mini" style="gap:12px">
                            <div class="stat-row">
                                <div class="stat">
                                    <div class="stat-label">Covers</div>
                                    <div class="stat-value">128</div>
                                </div>
                                <div class="stat">
                                    <div class="stat-label">Avg ticket</div>
                                    <div class="stat-value accent">€31</div>
                                </div>
                            </div>
                            <div class="bars">
                                <span style="height:38%"></span>
                                <span style="height:56%"></span>
                                <span style="height:44%"></span>
                                <span class="accent" style="height:78%"></span>
                                <span style="height:64%"></span>
                                <span class="ink" style="height:88%"></span>
                                <span style="height:52%"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="product-card">
                    <div class="product-head">
                        <div class="product-title-row">
                            <svg width="28" height="28" viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="24" r="19" stroke="#231813" stroke-width="4"></circle><path d="M5 24h38M24 5c5 6 5 32 0 38M24 5c-5 6-5 32 0 38" stroke="#231813" stroke-width="3"></path><circle cx="38" cy="12" r="6" fill="#D55C13"></circle></svg>
                            <div class="product-title">Restaurant websites</div>
                        </div>
                        <div class="product-desc">
