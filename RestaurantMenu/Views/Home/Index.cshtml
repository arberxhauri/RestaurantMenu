@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "Menus, websites & bookings for restaurants";
    Layout = null;

    var branches = ViewBag.Branches as IEnumerable<Branch> ?? new List<Branch>();
    var partners = branches.Where(b => !string.IsNullOrEmpty(b.Logo)).ToList();

    var isSignedIn = SignInManager.IsSignedIn(User);
    var ctaLabel = isSignedIn ? "Go to dashboard" : "Get started free";
    var showAnnouncementBar = false;
    var showPartners = partners.Any();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Digital menus, your website, table bookings and day-to-day management — all sharing one set of data. Change a price once and it lands everywhere in seconds." />
    <title>@ViewData["Title"] · My Quick Menu</title>
    <link rel="icon" type="image/png" href="~/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #231813;
            --cream: #FBF8F4;
            --orange: #D55C13;
            --orange-dark: #B54A0C;
            --orange-light: #E68C2C;
            --orange-deep: #A9490F;
            --muted: #5C4A40;
            --muted-2: #7A6A5E;
            --muted-3: #96826F;
            --line: #E7DFD6;
            --line-2: #EBE3DA;
            --line-3: #EFE7DE;
            --chip: #F1EAE2;
            --surface: #FDFBF9;
            --sand: #FAF6F1;
            --hatch: repeating-linear-gradient(135deg, #EFE4D8 0 10px, #E7DACC 10px 20px);
            --hatch-sm: repeating-linear-gradient(135deg, #EFE4D8 0 8px, #E7DACC 8px 16px);
            --mono: 'JetBrains Mono', ui-monospace, monospace;
        }

        *, *::before, *::after { box-sizing: border-box; }

        html { scroll-behavior: smooth; }

        body {
            margin: 0;
            background: var(--cream);
            color: var(--ink);
            font-family: Outfit, system-ui, -apple-system, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        a { color: var(--orange); text-decoration: none; }
        a:hover { color: var(--orange-dark); }

        h1, h2, p { margin: 0; }

        img { max-width: 100%; }

        .shell { max-width: 1200px; margin: 0 auto; padding: 0 32px; }

        section[id] { scroll-margin-top: 88px; }

        /* ---------- Announcement ---------- */
        .announce {
            background: var(--ink);
            color: var(--cream);
            font-size: 14px;
            padding: 11px 24px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            text-align: center;
        }
        .announce-tag { color: var(--orange-light); font-weight: 600; }
        .announce-text { opacity: .85; }

        /* ---------- Header ---------- */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 20;
            background: #FBF8F4EE;
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--line);
        }
        .header-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 16px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
        }
        .brand { display: flex; align-items: center; gap: 11px; color: var(--ink); }
        .brand:hover { color: var(--ink); }
        .brand svg { display: block; flex: none; }
        .brand-word {
            font-size: 21px;
            font-weight: 600;
            letter-spacing: -.038em;
            white-space: nowrap;
        }
        .brand-word em { color: var(--orange); font-style: normal; }

        .nav {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 15px;
            color: var(--muted);
            white-space: nowrap;
        }
        /* :not(.btn) so the nav's CTA keeps its own white-on-orange colours */
        .nav a:not(.btn) { color: var(--muted); }
        .nav a:not(.btn):hover { color: var(--ink); }

        .btn {
            display: inline-block;
            font-weight: 500;
            border-radius: 10px;
            transition: background-color .18s ease, border-color .18s ease, color .18s ease;
        }
        .btn-primary { background: var(--orange); color: #fff; padding: 10px 20px; }
        .btn-primary:hover { background: var(--orange-dark); color: #fff; }

        .nav-toggle {
            display: none;
            background: none;
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 9px 10px;
            cursor: pointer;
            color: var(--ink);
        }
        .nav-toggle svg { display: block; }

        /* ---------- Hero ---------- */
        .hero {
            max-width: 1200px;
            margin: 0 auto;
            padding: 88px 32px 96px;
            display: grid;
            grid-template-columns: 1.05fr .95fr;
            gap: 72px;
            align-items: center;
        }
        .hero-copy { display: flex; flex-direction: column; gap: 26px; }

        .eyebrow-pill {
            display: inline-flex;
            align-self: flex-start;
            align-items: center;
            gap: 9px;
            background: #F3E7DC;
            color: var(--orange-deep);
            font-family: var(--mono);
            font-size: 11.5px;
            letter-spacing: .1em;
            text-transform: uppercase;
            padding: 8px 14px;
            border-radius: 999px;
        }
        .dot { width: 6px; height: 6px; border-radius: 999px; background: var(--orange); flex: none; }

        .hero h1 {
            font-size: 64px;
            line-height: 1.02;
            letter-spacing: -.04em;
            font-weight: 600;
            text-wrap: balance;
        }
        .hero-lede {
            font-size: 19px;
            line-height: 1.6;
            color: var(--muted);
            max-width: 520px;
            text-wrap: pretty;
        }
        .hero-actions { display: flex; align-items: center; gap: 14px; padding-top: 6px; flex-wrap: wrap; }
        .btn-lg { font-size: 16px; padding: 15px 28px; border-radius: 12px; }
        .btn-ghost {
            border: 1px solid #DCD2C7;
            color: var(--ink);
            background: #fff;
        }
        .btn-ghost:hover { border-color: var(--ink); color: var(--ink); }

        .hero-meta {
            display: flex;
            align-items: center;
            gap: 20px;
            padding-top: 12px;
            font-size: 14px;
            color: var(--muted-2);
        }
        .sep { width: 4px; height: 4px; border-radius: 999px; background: #CFC4B8; flex: none; }

        /* ---------- Phone mockup ---------- */
        .hero-visual { display: flex; justify-content: center; }
        .phone {
            width: 320px;
            background: var(--ink);
            border-radius: 38px;
            padding: 12px;
            box-shadow: 0 30px 60px -20px #23181340;
        }
        .phone-screen { background: var(--cream); border-radius: 28px; overflow: hidden; }
        .phone-banner {
            height: 118px;
            background: var(--hatch);
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            padding: 12px 16px;
        }
        .banner-label {
            font-family: var(--mono);
            font-size: 10px;
            letter-spacing: .08em;
            color: var(--muted-3);
            text-transform: uppercase;
        }
        .lang-chip {
            background: var(--cream);
            border-radius: 999px;
            padding: 5px 11px;
            font-size: 11px;
            font-weight: 500;
            display: flex;
            gap: 6px;
            align-items: center;
        }
        .lang-chip .dot { width: 5px; height: 5px; }
        .phone-body { padding: 18px 18px 24px; display: flex; flex-direction: column; gap: 16px; }
        .phone-title { font-size: 19px; font-weight: 600; letter-spacing: -.02em; }
        .phone-sub { font-size: 12.5px; color: var(--muted-2); }
        .tabs { display: flex; gap: 8px; font-size: 12.5px; }
        .tab { background: var(--chip); color: var(--muted); padding: 7px 13px; border-radius: 999px; }
        .tab.is-active { background: var(--ink); color: var(--cream); font-weight: 500; }
        .dish-list { display: flex; flex-direction: column; gap: 12px; }
        .dish { display: flex; gap: 12px; align-items: center; }
        .dish-thumb { width: 52px; height: 52px; border-radius: 12px; background: var(--hatch-sm); flex: none; }
        .dish-text { flex: 1; display: flex; flex-direction: column; gap: 3px; }
        .dish-name { font-size: 14.5px; font-weight: 500; }
        .dish-desc { font-size: 12px; color: var(--muted-2); line-height: 1.4; }
        .dish-price { font-size: 14px; font-weight: 600; color: var(--orange); }

        /* ---------- Section headings ---------- */
        .band { background: #fff; border-top: 1px solid var(--line-3); }
        .band-both { border-bottom: 1px solid var(--line-3); }
        .band-inner { max-width: 1200px; margin: 0 auto; padding: 96px 32px; }

        .kicker {
            font-family: var(--mono);
            font-size: 11.5px;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--orange);
        }
        .section-head { display: flex; flex-direction: column; gap: 12px; max-width: 620px; }
        .section-head h2 {
            font-size: 44px;
            line-height: 1.08;
            letter-spacing: -.032em;
            font-weight: 600;
        }
        .section-head p { font-size: 17px; line-height: 1.6; color: var(--muted); }

        .head-row {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 52px;
        }
        .btn-outline {
            border: 1px solid #DCD2C7;
            color: var(--ink);
            background: var(--surface);
            font-size: 15px;
            padding: 13px 22px;
            border-radius: 11px;
            white-space: nowrap;
        }
        .btn-outline:hover { border-color: var(--ink); color: var(--ink); }

        /* ---------- Products ---------- */
        .product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
        .product-card {
            border: 1px solid var(--line-2);
            border-radius: 20px;
            overflow: hidden;
            background: var(--surface);
            display: flex;
            flex-direction: column;
        }
        .product-head { padding: 32px 32px 26px; display: flex; flex-direction: column; gap: 13px; }
        .product-title-row { display: flex; align-items: center; gap: 12px; }
        .product-title-row svg { display: block; flex: none; }
        .product-title { font-size: 22px; font-weight: 600; letter-spacing: -.022em; }
        .product-desc { font-size: 15.5px; line-height: 1.6; color: var(--muted); }
        .tag-row { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 4px; font-size: 13px; color: var(--muted); }
        .tag { background: var(--chip); border-radius: 999px; padding: 6px 12px; }
        .product-figure { margin-top: auto; padding: 0 32px 32px; }
        .mini {
            border: 1px solid var(--line-2);
            border-radius: 14px;
            background: #fff;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .mini-flush { padding: 0; overflow: hidden; gap: 0; }
        .mini-tabs { display: flex; gap: 8px; font-size: 12px; }
        .mini-tab { background: var(--chip); color: var(--muted); padding: 5px 11px; border-radius: 999px; }
        .mini-tab.is-active { background: var(--ink); color: var(--cream); }
        .mini-dish { display: flex; align-items: center; gap: 11px; }
        .mini-thumb { width: 40px; height: 40px; border-radius: 10px; background: var(--hatch-sm); flex: none; }
        .mini-name { flex: 1; font-size: 14px; font-weight: 500; }
        .mini-price { font-size: 13.5px; font-weight: 600; color: var(--orange); }

        .stat-row { display: flex; gap: 12px; }
        .stat {
            flex: 1;
            background: var(--sand);
            border-radius: 10px;
            padding: 11px 13px;
            display: flex;
            flex-direction: column;
            gap: 3px;
        }
        .stat-label {
            font-family: var(--mono);
            font-size: 10px;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--muted-3);
        }
        .stat-value { font-size: 18px; font-weight: 600; letter-spacing: -.02em; }
        .stat-value.accent { color: var(--orange); }
        .bars { display: flex; align-items: flex-end; gap: 6px; height: 52px; }
        .bars span { flex: 1; background: #EFE4D8; border-radius: 4px; }
        .bars .accent { background: var(--orange); }
        .bars .ink { background: var(--ink); }

        .browser-bar {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 10px 13px;
            border-bottom: 1px solid var(--chip);
        }
        .browser-dot { width: 8px; height: 8px; border-radius: 999px; background: #E7DACC; flex: none; }
        .browser-url {
            flex: 1;
            margin-left: 6px;
            background: var(--sand);
            border-radius: 999px;
            padding: 4px 10px;
            font-family: var(--mono);
            font-size: 10px;
            color: var(--muted-3);
        }
        .browser-hero {
            height: 76px;
            background: var(--hatch);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            font-weight: 600;
            letter-spacing: -.02em;
            color: var(--ink);
        }
        .browser-nav { padding: 12px 14px; display: flex; gap: 8px; font-size: 12px; color: var(--muted); }
        .browser-nav .primary { background: var(--orange); color: #fff; border-radius: 8px; padding: 6px 12px; font-weight: 500; }
        .browser-nav .plain { background: var(--chip); border-radius: 8px; padding: 6px 12px; }

        .booking-head { display: flex; justify-content: space-between; align-items: center; }
        .booking-date { font-size: 14px; font-weight: 600; letter-spacing: -.015em; }
        .booking-count { font-family: var(--mono); font-size: 11px; color: var(--muted-3); }
        .slots { display: flex; gap: 7px; flex-wrap: wrap; font-size: 12.5px; }
        .slot { border: 1px solid #E7DACC; border-radius: 8px; padding: 6px 11px; }
        .slot.is-full { color: var(--muted-3); }
        .slot.is-picked { background: var(--orange); color: #fff; border-color: var(--orange); font-weight: 500; }
        .guest { display: flex; align-items: center; gap: 10px; background: var(--sand); border-radius: 10px; padding: 10px 12px; }
        .avatar {
            width: 28px; height: 28px; border-radius: 999px;
            background: var(--ink); color: var(--cream);
            font-size: 11px; font-weight: 600;
            display: flex; align-items: center; justify-content: center; flex: none;
        }
        .guest-name { flex: 1; font-size: 13px; }
        .guest-state { font-family: var(--mono); font-size: 11px; color: var(--orange); }

        /* ---------- Features ---------- */
        .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
        .feature-card {
            border: 1px solid var(--line-2);
            border-radius: 18px;
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            background: var(--surface);
        }
        .feature-card svg { display: block; }
        .feature-title { font-size: 19px; font-weight: 600; letter-spacing: -.015em; }
        .feature-desc { font-size: 15px; line-height: 1.6; color: var(--muted); }

        /* ---------- How it works ---------- */
        .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
        .step {
            display: flex;
            flex-direction: column;
            gap: 16px;
            padding-top: 26px;
            border-top: 2px solid #E0D6CB;
        }
        .step:first-child { border-top-color: var(--ink); }
        .step-num { font-family: var(--mono); font-size: 15px; color: var(--orange); }
        .step-title { font-size: 24px; font-weight: 600; letter-spacing: -.022em; }
        .step-desc { font-size: 15.5px; line-height: 1.6; color: var(--muted); }

        /* ---------- Partners ---------- */
        .partners-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 80px 32px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 36px;
        }
        .partners-head { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
        .partners-head h2 { font-size: 32px; line-height: 1.15; letter-spacing: -.028em; font-weight: 600; }
        .partners-head p { font-size: 16px; color: var(--muted); }
        .partner-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; }
        .partner-card {
            width: 230px;
            height: 96px;
            border: 1px solid var(--line-2);
            border-radius: 14px;
            background: var(--surface);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 14px;
            transition: border-color .18s ease, transform .18s ease;
        }
        .partner-card:hover { border-color: var(--ink); transform: translateY(-2px); }
        .partner-card img { max-height: 64px; max-width: 100%; object-fit: contain; }

        /* ---------- CTA ---------- */
        .cta-inner { max-width: 1200px; margin: 0 auto; padding: 96px 32px; }
        .cta-panel {
            background: var(--ink);
            border-radius: 26px;
            padding: 76px 64px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
        }
        .cta-copy { display: flex; flex-direction: column; gap: 16px; max-width: 560px; }
        .cta-copy svg { display: block; }
        .cta-panel h2 {
            font-size: 42px;
            line-height: 1.08;
            letter-spacing: -.032em;
            font-weight: 600;
            color: var(--cream);
        }
        .cta-panel p { font-size: 17px; line-height: 1.6; color: #C9B9AC; }
        .btn-cta {
            background: var(--orange);
            color: #fff;
            font-size: 17px;
            padding: 17px 34px;
            border-radius: 13px;
            white-space: nowrap;
        }
        .btn-cta:hover { background: var(--orange-light); color: #fff; }

        /* ---------- Footer ---------- */
        .site-footer { border-top: 1px solid var(--line); }
        .footer-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 48px 32px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }
        .footer-brand { display: flex; align-items: center; gap: 11px; flex-wrap: wrap; }
        .footer-brand svg { display: block; flex: none; }
        .footer-word { font-size: 16px; font-weight: 600; letter-spacing: -.038em; }
        .footer-word em { color: var(--orange); font-style: normal; }
        .footer-tag { font-size: 14px; color: var(--muted-2); margin-left: 6px; }
        .footer-links { display: flex; align-items: center; flex-wrap: wrap; gap: 26px; font-size: 14px; color: var(--muted-2); }
        .footer-links a { color: var(--muted-2); }
        .footer-links a:hover { color: var(--ink); }

        /* ---------- Responsive ---------- */
        @@media (max-width: 1000px) {
            .feature-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @@media (max-width: 900px) {
            .nav { display: none; }
            .nav-toggle { display: block; }
            .header-inner { gap: 16px; }

            .nav.is-open {
                display: flex;
                position: absolute;
                left: 0;
                right: 0;
                top: 100%;
                flex-direction: column;
                align-items: stretch;
                gap: 4px;
                padding: 12px 24px 20px;
                background: var(--cream);
                border-bottom: 1px solid var(--line);
                font-size: 16px;
            }
            .nav.is-open a { padding: 10px 0; }
            .nav.is-open .btn-primary { text-align: center; padding: 13px 20px; margin-top: 8px; }

            .hero {
                grid-template-columns: 1fr;
                gap: 48px;
                padding: 56px 24px 72px;
            }
            .hero h1 { font-size: 44px; }
            .hero-lede { font-size: 17px; }

            .product-grid { grid-template-columns: 1fr; }
            .steps { grid-template-columns: 1fr; gap: 24px; }
            .step { border-top-color: var(--ink); }

            .band-inner, .cta-inner, .partners-inner { padding: 72px 24px; }
            .section-head h2 { font-size: 34px; }
            .cta-panel { padding: 48px 32px; }
            .cta-panel h2 { font-size: 32px; }
            .footer-inner, .header-inner { padding-left: 24px; padding-right: 24px; }
        }

        @@media (max-width: 680px) {
            .feature-grid { grid-template-columns: 1fr; }
            .hero h1 { font-size: 36px; }
            /* keep the hero dominant once headings shrink */
            .section-head h2 { font-size: 28px; }
            .partners-head h2 { font-size: 26px; }
            .cta-panel h2 { font-size: 28px; }
            .hero-meta { flex-wrap: wrap; gap: 10px; }
            .hero-meta .sep { display: none; }
            .hero-actions .btn-lg { flex: 1; text-align: center; }
            .phone { width: 100%; max-width: 320px; }
            .product-head { padding: 26px 22px 22px; }
            .product-figure { padding: 0 22px 26px; }
            .partner-card { width: 100%; max-width: 260px; }
            .footer-links { gap: 16px; }
            .footer-tag { margin-left: 0; width: 100%; }
        }

        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .partner-card:hover { transform: none; }
        }
    </style>
</head>
<body>

    @if (showAnnouncementBar)
    {
        <div class="announce">
            <span class="announce-tag">New</span>
            <span class="announce-text">QR table tents now ship free with every annual plan</span>
        </div>
    }

    <header class="site-header">
        <div class="header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <svg width="32" height="32" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                    <rect x="4.5" y="4.5" width="15" height="15" rx="4" stroke="#231813" stroke-width="5"></rect>
                    <rect x="26" y="2" width="20" height="20" rx="6.5" fill="#231813"></rect>
                    <rect x="2" y="26" width="20" height="20" rx="6.5" fill="#231813"></rect>
                    <circle cx="36" cy="36" r="10" fill="#D55C13"></circle>
                </svg>
                <span class="brand-word">myquick<em>menu</em></span>
            </a>

            <button class="nav-toggle" type="button" id="navToggle" aria-expanded="false" aria-controls="primaryNav" aria-label="Toggle navigation">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M3 6h18M3 12h18M3 18h18"></path>
                </svg>
