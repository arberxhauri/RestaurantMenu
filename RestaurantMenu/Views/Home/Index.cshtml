                                <span class="plain">Contact</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="product-card">
                    <div class="product-head">
                        <div class="product-title-row">
                            <svg width="28" height="28" viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="4" y="9" width="40" height="35" rx="7" stroke="#231813" stroke-width="4"></rect><path d="M4 20h40" stroke="#231813" stroke-width="4"></path><path d="M15 4v9M33 4v9" stroke="#231813" stroke-width="4" stroke-linecap="round"></path><circle cx="33" cy="32" r="5.5" fill="#D55C13"></circle></svg>
                            <div class="product-title">Bookings</div>
