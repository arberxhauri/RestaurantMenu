@using RestaurantMenu.Helpers
@using RestaurantMenu.Services
@{
    Layout = null;
    var chrome = (MarketingChrome)ViewData["Marketing"]!;
    var prices = ViewBag.Prices as MarketingPrices;
    var t = chrome.T;
    var lang = chrome.Lang;
    var branches = ViewBag.Branches as IEnumerable<Branch> ?? new List<Branch>();
    var partners = branches.Where(b => !string.IsNullOrEmpty(b.Logo)).ToList();
    var ctaLabel = chrome.CtaLabel;
    var ctaHref = chrome.CtaHref;
    var signupOpen = chrome.SignupOpen;
    var trialDays = chrome.TrialDays;
    var trialWords = SignupText.For(lang);
    var showPartners = partners.Any();
    // A marquee only reads as "lots of restaurants" when there are lots of them.
    var partnersAsMarquee = partners.Count >= 6;
    ViewData["MarketingIsHome"] = true;
    ViewData["MarketingShowPartners"] = showPartners;
}

<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    @await Html.PartialAsync("_SeoMeta", (SeoMetadata)ViewData["Seo"]!)
    <link rel="preload" as="image" href="~/img/hero-table.webp" fetchpriority="high" />
    <partial name="_HeadAssets" />
    <link rel="stylesheet" href="~/css/device.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/marketing-pages.css" asp-append-version="true" />
</head>
<body>
    <partial name="_MarketingHeader" model="chrome" />

    <main id="main">
        @* ================================================================
           HERO. Static by default (full-bleed photo, then the phone story
           below it). With motion allowed, landing.js pins the stage and
           scrubs: shared table -> one plate -> the plate becomes the banner
           of a phone menu -> the menu demonstrates a live edit.
           ================================================================ *@
        <section class="hero" id="top" data-hero aria-labelledby="hero-title">
            <div class="hero-stage" data-hero-stage>

                <div class="hero-cover">
                    <div class="hero-media" data-hero-media>
                        <img class="hero-img hero-img--table" data-hero-table
                             src="~/img/hero-table.webp" width="1920" height="1280"
                             alt="@t.HeroImageAlt"
                             fetchpriority="high" decoding="async" />
                        <img class="hero-img hero-img--plate" data-hero-plate
                             src="~/img/hero-plate.webp" width="900" height="900"
                             alt="" aria-hidden="true" decoding="async" />
                        <div class="hero-scrim" data-hero-scrim aria-hidden="true"></div>
                    </div>

                    <div class="hero-copy" data-hero-copy>
                        <h1 id="hero-title">@t.HeroTitle</h1>
                        <p class="hero-lede">@t.HeroLede</p>
                        <div class="hero-actions">
                            <a class="btn btn-primary btn-lg" href="@ctaHref">
                                @ctaLabel <i class="ph ph-arrow-right" aria-hidden="true"></i>
                            </a>
                            <a class="btn btn-glass btn-lg" href="#how-it-works">@t.SeeHow</a>
                        </div>
                    </div>
                </div>

                <div class="story" data-story>
                    <div class="story-text" data-story-text>
                        <h2>@t.StoryTitle</h2>
                        <p>@t.StoryText</p>
                    </div>

                    <div class="device" data-device>
                        <div class="device-screen">
                            <img class="device-banner" src="~/img/hero-plate.webp" width="900" height="900" alt="" aria-hidden="true" loading="lazy" />
                            <div class="device-ui" data-device-ui aria-label="@t.DeviceLabel">
                                <div class="dui-head">
                                    <div>
                                        <div class="dui-name">Oliva Kitchen</div>
                                        <div class="dui-sub">Table 14</div>
                                    </div>
                                    <span class="dui-lang swap">
                                        <span class="swap-a" data-lang-a>EN</span>
                                        <span class="swap-b" data-lang-b aria-hidden="true">SQ</span>
                                    </span>
                                </div>
                                <div class="dui-tabs" aria-hidden="true">
                                    <span class="is-active">Mains</span><span>Pizza</span><span>Salads</span>
                                </div>
                                <ul class="dui-list">
                                    <li class="dui-dish">
                                        <img src="~/img/dish-salad.webp" width="400" height="400" alt="" loading="lazy" />
                                        <div class="dui-text">
                                            <span class="swap dui-dish-name">
                                                <span class="swap-a" data-tr-a>Salmon poke bowl</span>
                                                <span class="swap-b" data-tr-b aria-hidden="true">Tas poke me salmon</span>
                                            </span>
                                            <span class="dui-desc">Rice, avocado, sesame</span>
                                        </div>
                                        <span class="swap dui-price tabular">
                                            <span class="swap-a" data-price-a>€12.00</span>
                                            <span class="swap-b" data-price-b aria-hidden="true">€13.50</span>
                                        </span>
                                    </li>
                                    <li class="dui-dish">
                                        <img src="~/img/dish-pizza.webp" width="400" height="400" alt="" loading="lazy" />
                                        <div class="dui-text">
                                            <span class="swap dui-dish-name">
                                                <span class="swap-a" data-tr-a>Wood-fired pizza</span>
                                                <span class="swap-b" data-tr-b aria-hidden="true">Pica në furrë me dru</span>
                                            </span>
                                            <span class="dui-desc">Fior di latte, basil</span>
                                        </div>
                                        <span class="dui-price tabular">€11.00</span>
                                    </li>
                                    <li class="dui-dish" data-soldout>
                                        <img src="~/img/dish-greens.webp" width="400" height="400" alt="" loading="lazy" />
                                        <div class="dui-text">
                                            <span class="swap dui-dish-name">
                                                <span class="swap-a" data-tr-a>Garden greens</span>
                                                <span class="swap-b" data-tr-b aria-hidden="true">Sallatë jeshile</span>
                                            </span>
                                            <span class="dui-desc">Seasonal leaves, citrus</span>
                                        </div>
                                        <span class="dui-price tabular">€9.00</span>
                                        <span class="dui-soldout" data-soldout-tag>Sold out</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="device-frame" aria-hidden="true"></div>
                    </div>

                    <ol class="callouts" data-callouts>
                        <li class="callout" data-callout>
                            <i class="ph ph-tag" aria-hidden="true"></i>
                            <div>
                                <strong>@t.Callout1Title</strong>
                                <span>@t.Callout1Text</span>
                            </div>
                        </li>
                        <li class="callout" data-callout>
                            <i class="ph ph-translate" aria-hidden="true"></i>
                            <div>
                                <strong>@t.Callout2Title</strong>
                                <span>@t.Callout2Text</span>
                            </div>
                        </li>
                        <li class="callout" data-callout>
                            <i class="ph ph-prohibit" aria-hidden="true"></i>
                            <div>
                                <strong>@t.Callout3Title</strong>
                                <span>@t.Callout3Text</span>
                            </div>
                        </li>
                    </ol>
                </div>
            </div>
        </section>

        @if (showPartners)
        {
            <section id="partners" class="partners" aria-labelledby="partners-title">
                <h2 id="partners-title" class="partners-title">@t.PartnersTitle</h2>
                <div class="partners-track @(partnersAsMarquee ? "is-marquee" : "")">
                    <ul class="partners-row">
                        @foreach (var branch in partners)
                        {
                            <li>
                                <a class="partner-logo" href="/menu/@branch.Slug"
                                   target="_blank" rel="noopener" title="@string.Format(t.PartnerMenu, branch.Name)">
                                    <img src="@ImageUrls.Sized(branch.Logo!, 320)" alt="@branch.Name" width="140" height="64" loading="lazy" decoding="async" />
                                </a>
                            </li>
                        }
                    </ul>
                    @if (partnersAsMarquee)
                    {
                        <ul class="partners-row" aria-hidden="true">
                            @foreach (var branch in partners)
                            {
                                <li>
                                    <span class="partner-logo">
                                        <img src="@ImageUrls.Sized(branch.Logo!, 320)" alt="" width="140" height="64" loading="lazy" decoding="async" />
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }

        <section id="products" class="section products" aria-labelledby="products-title">
            <div class="shell">
                <header class="section-head" data-reveal>
                    <h2 id="products-title">@t.ProductsTitle</h2>
                    <p>@t.ProductsText</p>
                </header>

                <div class="bento">
                    <article class="tile tile--menus" data-reveal>
                        <img class="tile-photo" src="~/img/guest-dining.webp" width="1200" height="800"
                             alt="@t.MenusImageAlt" loading="lazy" />
                        <div class="tile-body tile-body--overlay">
                            <h3><i class="ph ph-qr-code" aria-hidden="true"></i>@t.MenusTitle</h3>
                            <p>@t.MenusText</p>
                            <ul class="tags">
                                @foreach (var tag in t.MenusTags) { <li>@tag</li> }
                            </ul>
                            <a class="tile-more" href="@chrome.Link("/digital-menu")">@t.LearnMore: @t.NavDigitalMenu <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                        </div>
                    </article>

                    <article class="tile tile--ops" data-reveal>
                        <div class="tile-body">
                            <h3><i class="ph ph-squares-four" aria-hidden="true"></i>@t.OpsTitle</h3>
                            <p>@t.OpsText</p>
                            <ul class="tags">
                                @foreach (var tag in t.OpsTags) { <li>@tag</li> }
                            </ul>
                            <a class="tile-more" href="@chrome.Link("/restaurant-management")">@t.LearnMore: @t.NavManagement <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                        </div>
                        <img class="tile-photo tile-photo--inset" src="~/img/chef-plating.webp" width="900" height="1385"
                             alt="@t.OpsImageAlt" loading="lazy" />
                    </article>

                    <article class="tile tile--web" data-reveal>
                        <img class="tile-photo tile-photo--top" src="~/img/cafe-interior.webp" width="1200" height="900"
                             alt="@t.WebImageAlt" loading="lazy" />
                        <div class="tile-body">
                            <h3><i class="ph ph-globe-simple" aria-hidden="true"></i>@t.WebTitle</h3>
                            <p>@t.WebText</p>
                            <ul class="tags">
                                @foreach (var tag in t.WebTags) { <li>@tag</li> }
                            </ul>
                            <a class="tile-more" href="@chrome.Link("/restaurant-website")">@t.LearnMore: @t.NavWebsite <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                        </div>
                    </article>

                    <article class="tile tile--book" data-reveal>
                        <div class="tile-body">
                            <h3><i class="ph ph-calendar-check" aria-hidden="true"></i>@t.BookTitle</h3>
                            <p>@t.BookText</p>
                            <div class="slots" role="group" aria-label="@t.SlotsLabel">
                                <button type="button" class="slot" disabled>18:00</button>
                                <button type="button" class="slot" aria-pressed="false">18:30</button>
                                <button type="button" class="slot" aria-pressed="true">19:00</button>
                                <button type="button" class="slot" aria-pressed="false">19:30</button>
                                <button type="button" class="slot" disabled>20:00</button>
                                <button type="button" class="slot" aria-pressed="false">20:30</button>
                            </div>
                            <p class="slot-note" aria-live="polite" data-slot-note data-template="@t.SlotNote">@string.Format(t.SlotNote, "19:00")</p>
                            <a class="tile-more" href="@chrome.Link("/table-bookings")">@t.LearnMore: @t.NavBookings <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                        </div>
                        <img class="tile-photo tile-photo--side" src="~/img/terrace.webp" width="1200" height="900"
                             alt="@t.BookImageAlt" loading="lazy" />
                    </article>
                </div>
            </div>
        </section>

        <section id="features" class="section features" aria-labelledby="features-title">
            <div class="shell features-grid">
                <header class="features-head">
                    <h2 id="features-title">@t.FeaturesTitle</h2>
                    <p>@t.FeaturesText</p>
                </header>
                <ul class="feature-list">
                    @{ var featureIcons = new[] { "ph-translate", "ph-device-mobile", "ph-lightning", "ph-palette", "ph-hand-grabbing", "ph-shield-check" }; }
                    @for (var n = 0; n < t.Features.Length; n++)
                    {
                        <li data-reveal>
                            <i class="ph @featureIcons[n]" aria-hidden="true"></i>
                            <h3>@t.Features[n].Title</h3>
                            <p>@t.Features[n].Text</p>
                        </li>
                    }
                </ul>
            </div>
        </section>

        <section id="how-it-works" class="section steps" aria-labelledby="steps-title">
            <div class="shell">
                <header class="section-head" data-reveal>
                    <h2 id="steps-title">@t.StepsTitle</h2>
                </header>
            </div>
            <div class="stack" data-stack>
                <article class="stack-card" data-stack-card>
                    <div class="stack-inner">
                        <div class="stack-copy">
                            <h3>@t.Steps[0].Title</h3>
                            <p>@t.Steps[0].Text</p>
                        </div>
                        <img src="~/img/dining-room.webp" width="1400" height="934" alt="@t.Steps[0].ImageAlt" loading="lazy" />
                    </div>
                </article>
                <article class="stack-card" data-stack-card>
                    <div class="stack-inner">
                        <div class="stack-copy">
                            <h3>@t.Steps[1].Title</h3>
                            <p>@t.Steps[1].Text</p>
                        </div>
                        <img src="~/img/chef-prep.webp" width="900" height="1350" alt="@t.Steps[1].ImageAlt" loading="lazy" />
                    </div>
                </article>
                <article class="stack-card" data-stack-card>
                    <div class="stack-inner">
                        <div class="stack-copy">
                            <h3>@t.Steps[2].Title</h3>
                            <p>@t.Steps[2].Text</p>
                        </div>
                        <img src="~/img/fine-dining.webp" width="1400" height="934" alt="@t.Steps[2].ImageAlt" loading="lazy" />
                    </div>
                </article>
            </div>
        </section>

        @if (prices != null && prices.Presets.Any(p => p.Quote.Complete))
        {
            <section id="pricing" class="section pricing-teaser" aria-labelledby="pricing-title">
                <div class="shell">
                    <header class="section-head" data-reveal>
                        <h2 id="pricing-title">@t.PricingTitle</h2>
                        <p>@string.Format(t.PricingText, trialDays)</p>
                    </header>
                    <div class="teaser-grid">
                        @foreach (var (key, quote) in prices.Presets)
                        {
                            var (title, text) = SignupText.Preset(trialWords, key);
                            <a class="teaser" href="@chrome.Link("/pricing")@(lang == "en" ? "?" : "&")preset=@key#build" data-reveal>
                                <h3>@title</h3>
                                <p>@text</p>
                                <span class="teaser-price">@(quote.Complete ? string.Format(trialWords.FromPerMonth, PricingRules.Money(quote.PerMonthCents, quote.Currency)) : trialWords.PriceOnRequest)</span>
                                <span class="teaser-go">@(signupOpen ? t.StartTrial : t.SeePricing) <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
                            </a>
                        }
                    </div>
                    <p class="teaser-more"><a href="@chrome.Link("/pricing")">@t.BuildOwnPlan</a></p>
                </div>
            </section>
        }

        <section id="cta" class="cta" aria-labelledby="cta-title">
            <img class="cta-photo" src="~/img/evening-room.webp" width="1200" height="1812" alt="" aria-hidden="true" loading="lazy" />
            <div class="cta-inner" data-reveal>
                <h2 id="cta-title">@t.CtaTitle</h2>
                <p>@t.CtaText @(signupOpen ? string.Format(t.CtaTrial, trialDays) : t.CtaContact)</p>
                <a class="btn btn-primary btn-lg" href="@ctaHref">
                    @ctaLabel <i class="ph ph-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </section>
    </main>

    <partial name="_MarketingFooter" model="chrome" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
    <script src="@("https://unpkg.com/lenis@1.1.13/dist/lenis.min.js")" defer></script>
    <script src="~/js/landing.js" asp-append-version="true" defer></script>
</body>
</html>
