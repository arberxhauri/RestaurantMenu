@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Menus, websites & bookings for restaurants";
    Layout = null;

    var branches = ViewBag.Branches as IEnumerable<Branch> ?? new List<Branch>();
    var partners = branches.Where(b => !string.IsNullOrEmpty(b.Logo)).ToList();

    var isSignedIn = SignInManager.IsSignedIn(User);
    // One label per intent, used in the nav, the hero and the closing CTA. There is no
    // self-serve signup (accounts are created by an admin and get an invite link), so
    // visitors are sent to whoever sets up accounts, not to a sign-in form they can't use.
    // Landing__ContactUrl can be a mailto:, a form or a WhatsApp link.
    var contactUrl = Configuration["Landing:ContactUrl"] is { Length: > 0 } configured ? configured : "https://4cs.al/";
    var ctaLabel = isSignedIn ? "Go to dashboard" : "Get in touch";
    var ctaHref = isSignedIn ? Url.Action("Index", "Dashboard") : contactUrl;
    var showPartners = partners.Any();
    // A marquee only reads as "lots of restaurants" when there are lots of them.
    var partnersAsMarquee = partners.Count >= 6;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    @await Html.PartialAsync("_SeoMeta", (SeoMetadata)ViewData["Seo"]!)
    <link rel="preload" as="image" href="~/img/hero-table.webp" fetchpriority="high" />
    <partial name="_HeadAssets" />
    <link rel="stylesheet" href="~/css/device.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-header>
        <div class="header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="My Quick Menu, home">
                <partial name="_BrandMark" model="30" />
                <span class="brand-word">myquick<em>menu</em></span>
            </a>

            <nav class="nav" id="primaryNav" aria-label="Primary">
                <a href="#products">Products</a>
                <a href="#features">Features</a>
                <a href="#how-it-works">How it works</a>
                @if (showPartners)
                {
                    <a href="#partners">Partners</a>
                }
                @if (isSignedIn)
                {
                    <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                }
                <a class="btn btn-primary" href="@ctaHref">@ctaLabel</a>
            </nav>

            <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="primaryNav" aria-label="Open menu">
                <i class="ph ph-list" aria-hidden="true"></i>
            </button>
        </div>
    </header>

    <main id="main">
        @* ================================================================
           HERO. Static by default (full-bleed photo, then the phone story
           below it). With motion allowed, landing.js pins the stage and
           scrubs: shared table -> one plate -> the plate becomes the banner
           of a phone menu -> the menu demonstrates a live edit.
           ================================================================ *@
        <section class="hero" id="top" data-hero aria-labelledby="hero-title">
            <div class="hero-stage" data-hero-stage>

                <div class="hero-cover">
                    <div class="hero-media" data-hero-media>
                        <img class="hero-img hero-img--table" data-hero-table
                             src="~/img/hero-table.webp" width="1920" height="1280"
                             alt="Friends sharing breakfast plates around a wooden table"
                             fetchpriority="high" decoding="async" />
                        <img class="hero-img hero-img--plate" data-hero-plate
                             src="~/img/hero-plate.webp" width="900" height="900"
                             alt="" aria-hidden="true" decoding="async" />
                        <div class="hero-scrim" data-hero-scrim aria-hidden="true"></div>
                    </div>

                    <div class="hero-copy" data-hero-copy>
                        <h1 id="hero-title">The whole restaurant, one platform</h1>
                        <p class="hero-lede">
                            Digital menus, your website, bookings and the back office on one set of data.
                            Change a price once and it lands everywhere.
                        </p>
                        <div class="hero-actions">
                            <a class="btn btn-primary btn-lg" href="@ctaHref">
                                @ctaLabel <i class="ph ph-arrow-right" aria-hidden="true"></i>
                            </a>
                            <a class="btn btn-glass btn-lg" href="#how-it-works">See how it works</a>
                        </div>
                    </div>
                </div>

                <div class="story" data-story>
                    <div class="story-text" data-story-text>
                        <h2>Change it once. It's on every table.</h2>
                        <p>One menu lives behind every QR code, so a price, a language or a sold-out dish updates wherever guests are looking.</p>
                    </div>

                    <div class="device" data-device>
                        <div class="device-screen">
                            <img class="device-banner" src="~/img/hero-plate.webp" width="900" height="900" alt="" aria-hidden="true" loading="lazy" />
                            <div class="device-ui" data-device-ui aria-label="Example of a guest's menu">
                                <div class="dui-head">
                                    <div>
                                        <div class="dui-name">Oliva Kitchen</div>
                                        <div class="dui-sub">Table 14</div>
                                    </div>
                                    <span class="dui-lang swap">
                                        <span class="swap-a" data-lang-a>EN</span>
                                        <span class="swap-b" data-lang-b aria-hidden="true">SQ</span>
                                    </span>
                                </div>
                                <div class="dui-tabs" aria-hidden="true">
                                    <span class="is-active">Mains</span><span>Pizza</span><span>Salads</span>
                                </div>
                                <ul class="dui-list">
                                    <li class="dui-dish">
                                        <img src="~/img/dish-salad.webp" width="400" height="400" alt="" loading="lazy" />
                                        <div class="dui-text">
                                            <span class="swap dui-dish-name">
                                                <span class="swap-a" data-tr-a>Salmon poke bowl</span>
                                                <span class="swap-b" data-tr-b aria-hidden="true">Tas poke me salmon</span>
                                            </span>
                                            <span class="dui-desc">Rice, avocado, sesame</span>
                                        </div>
                                        <span class="swap dui-price tabular">
                                            <span class="swap-a" data-price-a>€12.00</span>
                                            <span class="swap-b" data-price-b aria-hidden="true">€13.50</span>
                                        </span>
                                    </li>
                                    <li class="dui-dish">
                                        <img src="~/img/dish-pizza.webp" width="400" height="400" alt="" loading="lazy" />
                                        <div class="dui-text">
                                            <span class="swap dui-dish-name">
                                                <span class="swap-a" data-tr-a>Wood-fired pizza</span>
                                                <span class="swap-b" data-tr-b aria-hidden="true">Pica në furrë me dru</span>
                                            </span>
                                            <span class="dui-desc">Fior di latte, basil</span>
                                        </div>
                                        <span class="dui-price tabular">€11.00</span>
                                    </li>
                                    <li class="dui-dish" data-soldout>
                                        <img src="~/img/dish-greens.webp" width="400" height="400" alt="" loading="lazy" />
                                        <div class="dui-text">
                                            <span class="swap dui-dish-name">
                                                <span class="swap-a" data-tr-a>Garden greens</span>
                                                <span class="swap-b" data-tr-b aria-hidden="true">Sallatë jeshile</span>
                                            </span>
                                            <span class="dui-desc">Seasonal leaves, citrus</span>
                                        </div>
                                        <span class="dui-price tabular">€9.00</span>
                                        <span class="dui-soldout" data-soldout-tag>Sold out</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="device-frame" aria-hidden="true"></div>
                    </div>

                    <ol class="callouts" data-callouts>
                        <li class="callout" data-callout>
                            <i class="ph ph-tag" aria-hidden="true"></i>
                            <div>
                                <strong>Price changed in the dashboard</strong>
                                <span>The next guest to open the menu sees the new price.</span>
                            </div>
                        </li>
                        <li class="callout" data-callout>
                            <i class="ph ph-translate" aria-hidden="true"></i>
                            <div>
                                <strong>Guest switched to Shqip</strong>
                                <span>Seven languages, written once by you.</span>
                            </div>
                        </li>
                        <li class="callout" data-callout>
                            <i class="ph ph-prohibit" aria-hidden="true"></i>
                            <div>
                                <strong>Marked as sold out</strong>
                                <span>Guests can no longer order it from the table.</span>
                            </div>
                        </li>
                    </ol>
                </div>
            </div>
        </section>

        @if (showPartners)
        {
            <section id="partners" class="partners" aria-labelledby="partners-title">
                <h2 id="partners-title" class="partners-title">Restaurants already serving with My Quick Menu</h2>
                <div class="partners-track @(partnersAsMarquee ? "is-marquee" : "")">
                    <ul class="partners-row">
                        @foreach (var branch in partners)
                        {
                            <li>
                                <a class="partner-logo" asp-controller="Menu" asp-action="Index"
                                   asp-route-branchName="@SeoService.Slug(branch.Name)"
                                   target="_blank" rel="noopener" title="@branch.Name menu">
                                    <img src="@branch.Logo" alt="@branch.Name" width="140" height="64" loading="lazy" />
                                </a>
                            </li>
                        }
                    </ul>
                    @if (partnersAsMarquee)
                    {
                        <ul class="partners-row" aria-hidden="true">
                            @foreach (var branch in partners)
                            {
                                <li>
                                    <span class="partner-logo">
                                        <img src="@branch.Logo" alt="" width="140" height="64" loading="lazy" />
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }

        <section id="products" class="section products" aria-labelledby="products-title">
            <div class="shell">
                <header class="section-head" data-reveal>
                    <h2 id="products-title">Four products, one back office</h2>
                    <p>Start with the menu and add the rest when you need it. Dishes, hours and branches are entered once and shared across everything.</p>
                </header>

                <div class="bento">
                    <article class="tile tile--menus" data-reveal>
                        <img class="tile-photo" src="~/img/guest-dining.webp" width="1200" height="800"
                             alt="A guest enjoying dinner in a warmly lit restaurant" loading="lazy" />
                        <div class="tile-body tile-body--overlay">
                            <h3><i class="ph ph-qr-code" aria-hidden="true"></i>Digital menus</h3>
                            <p>QR menus guests scan at the table. Multilingual, photo-rich, allergen-aware and editable mid-service, with orders sent straight to the kitchen.</p>
                            <ul class="tags">
                                <li>QR &amp; table tents</li><li>Table ordering</li><li>Allergens</li>
                            </ul>
                        </div>
                    </article>

                    <article class="tile tile--ops" data-reveal>
                        <div class="tile-body">
                            <h3><i class="ph ph-squares-four" aria-hidden="true"></i>Management system</h3>
                            <p>Kitchen display, stock, staff shifts and end-of-day sales in one dashboard. Multi-branch from day one, with every branch on one overview.</p>
                            <ul class="tags">
                                <li>Kitchen display</li><li>Stock &amp; recipes</li><li>Shifts &amp; sales</li>
                            </ul>
                        </div>
                        <img class="tile-photo tile-photo--inset" src="~/img/chef-plating.webp" width="900" height="1385"
                             alt="A chef finishing plates under copper pass lights" loading="lazy" />
                    </article>

                    <article class="tile tile--web" data-reveal>
                        <img class="tile-photo tile-photo--top" src="~/img/cafe-interior.webp" width="1200" height="900"
                             alt="A bright café dining room with wooden tables" loading="lazy" />
                        <div class="tile-body">
                            <h3><i class="ph ph-globe-simple" aria-hidden="true"></i>Restaurant websites</h3>
                            <p>A fast site on a free subdomain or your own domain. It pulls its dishes, photos and hours straight from your dashboard, so it's never out of date.</p>
                            <ul class="tags">
                                <li>Free subdomain</li><li>Own domain</li><li>SEO ready</li>
                            </ul>
                        </div>
                    </article>

                    <article class="tile tile--book" data-reveal>
                        <div class="tile-body">
                            <h3><i class="ph ph-calendar-check" aria-hidden="true"></i>Bookings</h3>
                            <p>Take reservations from the site, the menu QR or your Instagram link. Confirmations and reminders by SMS or email, no-shows tracked.</p>
                            <div class="slots" role="group" aria-label="Try it: pick a time for Friday">
                                <button type="button" class="slot" disabled>18:00</button>
                                <button type="button" class="slot" aria-pressed="false">18:30</button>
                                <button type="button" class="slot" aria-pressed="true">19:00</button>
                                <button type="button" class="slot" aria-pressed="false">19:30</button>
                                <button type="button" class="slot" disabled>20:00</button>
                                <button type="button" class="slot" aria-pressed="false">20:30</button>
                            </div>
                            <p class="slot-note" aria-live="polite" data-slot-note>Table for 4 held at 19:00. Confirmation goes out by SMS or email.</p>
                        </div>
                        <img class="tile-photo tile-photo--side" src="~/img/terrace.webp" width="1200" height="900"
                             alt="A seaside restaurant terrace set for dinner" loading="lazy" />
                    </article>
                </div>
            </div>
        </section>

        <section id="features" class="section features" aria-labelledby="features-title">
            <div class="shell features-grid">
                <header class="features-head">
                    <h2 id="features-title">Shared across every product</h2>
                    <p>Built for the way restaurants actually work: mid-service edits, seasonal swaps, and guests who don't all speak your language.</p>
                </header>
                <ul class="feature-list">
                    <li data-reveal>
                        <i class="ph ph-translate" aria-hidden="true"></i>
                        <h3>Multilingual support</h3>
                        <p>Serve international guests in their own language. They switch in one tap; you write it once.</p>
                    </li>
                    <li data-reveal>
                        <i class="ph ph-device-mobile" aria-hidden="true"></i>
                        <h3>Mobile optimised</h3>
                        <p>Menus built phone-first: legible in low light, thumb-reachable, and once opened they keep working when the Wi-Fi drops.</p>
                    </li>
                    <li data-reveal>
                        <i class="ph ph-lightning" aria-hidden="true"></i>
                        <h3>Instant updates</h3>
                        <p>Sold out at 19:40? One tap. The next guest to open the menu sees it, and table orders for it are refused.</p>
                    </li>
                    <li data-reveal>
                        <i class="ph ph-palette" aria-hidden="true"></i>
                        <h3>Custom branding</h3>
                        <p>Your colours, your logo, your banner. The menu looks like your room, not like software.</p>
                    </li>
                    <li data-reveal>
                        <i class="ph ph-hand-grabbing" aria-hidden="true"></i>
                        <h3>Easy management</h3>
                        <p>Branches, categories and dishes in one dashboard. Drag to reorder, no training needed.</p>
                    </li>
                    <li data-reveal>
                        <i class="ph ph-shield-check" aria-hidden="true"></i>
                        <h3>Secure &amp; reliable</h3>
                        <p>Encrypted connections, role-based access, and deleted branches you can recover. Your menu is up when your doors are.</p>
                    </li>
                </ul>
            </div>
        </section>

        <section id="how-it-works" class="section steps" aria-labelledby="steps-title">
            <div class="shell">
                <header class="section-head" data-reveal>
                    <h2 id="steps-title">Three steps to going live</h2>
                </header>
            </div>
            <div class="stack" data-stack>
                <article class="stack-card" data-stack-card>
                    <div class="stack-inner">
                        <div class="stack-copy">
                            <h3>Create your branch</h3>
                            <p>Name, address, logo and banner. Each location gets its own menu, its own colours and its own link.</p>
                        </div>
                        <img src="~/img/dining-room.webp" width="1400" height="934" alt="An empty dining room ready for service" loading="lazy" />
                    </div>
                </article>
                <article class="stack-card" data-stack-card>
                    <div class="stack-inner">
                        <div class="stack-copy">
                            <h3>Add your menu</h3>
                            <p>Categories, dishes, prices, photos and allergens. Translate each dish once and every guest reads it in their language.</p>
                        </div>
                        <img src="~/img/chef-prep.webp" width="900" height="1350" alt="A chef chopping herbs on a board" loading="lazy" />
                    </div>
                </article>
                <article class="stack-card" data-stack-card>
                    <div class="stack-inner">
                        <div class="stack-copy">
                            <h3>Switch on the rest</h3>
                            <p>Print the QR, publish the website, open the booking calendar. Same data, three new front doors.</p>
                        </div>
                        <img src="~/img/fine-dining.webp" width="1400" height="934" alt="A plated dish on a set table" loading="lazy" />
                    </div>
                </article>
            </div>
        </section>

        <section id="cta" class="cta" aria-labelledby="cta-title">
            <img class="cta-photo" src="~/img/evening-room.webp" width="1200" height="1812" alt="" aria-hidden="true" loading="lazy" />
            <div class="cta-inner" data-reveal>
                <h2 id="cta-title">Run the whole room from one place</h2>
                <p>Menus, website, bookings and back office. Start with one, add the rest whenever. Tell us about your restaurant and we'll set up your account.</p>
                <a class="btn btn-primary btn-lg" href="@ctaHref">
                    @ctaLabel <i class="ph ph-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="shell footer-inner">
            <div class="footer-brand">
                <partial name="_BrandMark" model="26" />
                <span class="brand-word">myquick<em>menu</em></span>
                <span class="footer-tag">Menus, websites &amp; bookings</span>
            </div>
            <nav class="footer-links" aria-label="Footer">
                <a href="#products">Products</a>
                <a href="#features">Features</a>
                @if (showPartners)
                {
                    <a href="#partners">Partners</a>
                }
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>
            <div class="footer-end">
                <partial name="_FourCsCredit" />
                <span>&copy; @DateTime.Now.Year My Quick Menu</span>
            </div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
    <script src="@("https://unpkg.com/lenis@1.1.13/dist/lenis.min.js")" defer></script>
    <script src="~/js/landing.js" asp-append-version="true" defer></script>
</body>
</html>
