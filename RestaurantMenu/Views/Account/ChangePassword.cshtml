@model RestaurantMenu.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<header class="page-head">
    <div>
        <h1>Change password</h1>
        <p>At least 8 characters with an upper-case letter, a lower-case letter and a number. If you were given a temporary password, replace it here.</p>
    </div>
</header>

<form asp-action="ChangePassword" method="post" class="form-layout form-layout--narrow">
    <div class="panel">
        <div asp-validation-summary="ModelOnly" class="m-4 mb-0"></div>
        <section class="form-section">
            <div class="fields">
                <div class="span-2">
                    <label asp-for="CurrentPassword" class="form-label">Current password</label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword"></span>
                </div>
                <div>
                    <label asp-for="NewPassword" class="form-label">New password</label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="form-label">Repeat new password</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
            </div>
        </section>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="ph ph-key" aria-hidden="true"></i>Update password</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
