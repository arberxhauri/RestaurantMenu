@model RestaurantMenu.ViewModels.SetPasswordViewModel
@using RestaurantMenu.Services
@{
    // One page for both emailed links: invites ("invite": a first password) and
    // password resets ("reset"). AccountController sets Mode and, for a bad link, LinkState.
    var reset = (ViewBag.Mode as string) == "reset";
    var invalid = ViewBag.LinkInvalid == true;
    var used = (ViewBag.LinkState as string) == "used";
    ViewData["Title"] = invalid ? "Link expired" : reset ? "Choose a new password" : "Set your password";
    Layout = "_AuthLayout";
}

@if (invalid && used)
{
    <h1>Your password is already set</h1>
    <p class="auth-sub">This invite was used. Sign in with your email and the password you chose. Forgotten it? Reset it from the sign-in page.</p>
    <div class="auth-actions">
        <a class="btn btn-primary btn-lg" asp-action="Login">Go to sign in</a>
        <a class="btn btn-outline-secondary btn-lg" asp-action="ForgotPassword">Reset password</a>
    </div>
}
else if (invalid && reset)
{
    <h1>This link has expired</h1>
    <p class="auth-sub">Reset links work once, for @AccountTokens.ResetLifespanText, and only the newest one counts. Ask for a new link and use it straight away.</p>
    <div class="auth-actions">
        <a class="btn btn-primary btn-lg" asp-action="ForgotPassword">Send a new link</a>
        <a class="btn btn-outline-secondary btn-lg" asp-action="Login">Go to sign in</a>
    </div>
}
else if (invalid)
{
    <h1>This link has expired</h1>
    <p class="auth-sub">Invite links work once, for @AccountTokens.InviteLifespanText. Ask whoever invited you (the restaurant owner, or your My Quick Menu contact) to send a new one, or get a link by email yourself.</p>
    <div class="auth-actions">
        <a class="btn btn-primary btn-lg" asp-action="ForgotPassword">Email me a link</a>
        <a class="btn btn-outline-secondary btn-lg" asp-action="Login">Go to sign in</a>
    </div>
}
else
{
    <h1>@(reset ? "Choose a new password" : "Set your password")</h1>
    <p class="auth-sub">For @ViewBag.Email. @(reset ? "Your old password stops working, and other devices are signed out within half an hour." : "You'll use it to sign in from now on.")</p>

    <form asp-action="@(reset ? "ResetPassword" : "SetPassword")" method="post" novalidate>
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" role="alert"></div>

        <input type="email" name="username" value="@ViewBag.Email" autocomplete="username" hidden readonly />

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">New password</label>
            <input asp-for="NewPassword" class="form-control form-control-lg" autocomplete="new-password" autofocus />
            <span class="hint">At least 8 characters with an upper-case letter, a lower-case letter and a number.</span>
            <span asp-validation-for="NewPassword"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label">Repeat password</label>
            <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">
            @(reset ? "Save password and sign in" : "Set password and sign in") <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </button>
    </form>
}
