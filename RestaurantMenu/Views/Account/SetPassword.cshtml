@model RestaurantMenu.ViewModels.SetPasswordViewModel
@{
    ViewData["Title"] = "Set your password";
    Layout = null;
    var invalid = ViewBag.LinkInvalid == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Set your password - My Quick Menu</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <partial name="_HeadAssets" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth">
        <div class="auth-form-side">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <partial name="_BrandMark" model="28" />
                <span class="brand-word">myquick<em>menu</em></span>
            </a>

            <main class="auth-form-wrap" id="main">
                @if (invalid)
                {
                    <h1>This link has expired</h1>
                    <p class="auth-sub">Invite links work for 3 days and only once. Ask your My Quick Menu administrator to send a new one.</p>
                    <a class="btn btn-outline-secondary" asp-action="Login">Go to sign in</a>
                }
                else
                {
                    <h1>Set your password</h1>
                    <p class="auth-sub">For @ViewBag.Email. You'll use it to sign in from now on.</p>

                    <form asp-action="SetPassword" method="post" novalidate>
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Token" />
                        <div asp-validation-summary="ModelOnly" role="alert"></div>

                        <input type="email" name="username" value="@ViewBag.Email" autocomplete="username" hidden readonly />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">New password</label>
                            <input asp-for="NewPassword" class="form-control form-control-lg" autocomplete="new-password" />
                            <span class="hint">At least 8 characters with an upper-case letter, a lower-case letter and a number.</span>
                            <span asp-validation-for="NewPassword"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Repeat password</label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Set password and sign in <i class="ph ph-arrow-right" aria-hidden="true"></i>
                        </button>
                    </form>
                }
            </main>

            <footer class="auth-foot">
                <span>&copy; @DateTime.Now.Year My Quick Menu</span>
                <partial name="_FourCsCredit" />
            </footer>
        </div>

        <figure class="auth-photo m-0">
            <img src="~/img/plates-overhead.webp" width="1400" height="934" alt="Plates of food shared across a dark wooden table" />
            <figcaption>Change a price once. It's on every table a second later.</figcaption>
        </figure>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
