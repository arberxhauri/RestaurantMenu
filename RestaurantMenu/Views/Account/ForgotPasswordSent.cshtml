@using RestaurantMenu.Services
@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}

<h1>Check your email</h1>
<p class="auth-sub">If <strong>@ViewBag.Email</strong> has a My Quick Menu account, a link to choose a new password is on its way. It works once, for @AccountTokens.ResetLifespanText.</p>

<ul class="auth-tips">
    <li>It usually arrives within a minute. Look in spam or promotions too.</li>
    <li>Nothing after a few minutes? Check the address and ask again. Only the newest link works.</li>
    <li>Your current password keeps working until you choose a new one.</li>
</ul>

<div class="auth-actions">
    <a class="btn btn-primary btn-lg" asp-action="Login">Back to sign in</a>
    <a class="btn btn-outline-secondary btn-lg" asp-action="ForgotPassword">Try another email</a>
</div>
