@model RestaurantMenu.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset your password";
    Layout = "_AuthLayout";
    var canEmail = ViewBag.CanEmail == true;
}

<h1>Reset your password</h1>

@if (!canEmail)
{
    <p class="auth-sub">Password reset by email isn't switched on for this site yet.</p>
    <div class="flash flash--warn mb-4" role="status">
        <i class="ph ph-info" aria-hidden="true"></i>
        <p>Ask your My Quick Menu contact (the site administrator) for a reset link. They can make one for any account and send it to you.</p>
    </div>
    <a class="btn btn-outline-secondary btn-lg" asp-action="Login"><i class="ph ph-arrow-left" aria-hidden="true"></i>Back to sign in</a>
}
else
{
    <p class="auth-sub">Enter the email you sign in with. We'll send you a link to choose a new password.</p>

    <form asp-action="ForgotPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" role="alert"></div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control form-control-lg" autocomplete="username" spellcheck="false" autofocus placeholder="you@restaurant.al…" />
            <span asp-validation-for="Email"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">
            Send reset link <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
        </button>
    </form>

    <p class="auth-alt"><a class="auth-link" asp-action="Login"><i class="ph ph-arrow-left" aria-hidden="true"></i> Back to sign in</a></p>
}
