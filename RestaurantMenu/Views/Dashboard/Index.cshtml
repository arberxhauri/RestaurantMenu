@using RestaurantMenu.Services
@using RestaurantMenu.ViewModels
@model IEnumerable<Branch>
@{
    ViewData["Title"] = "My branches";
    var branches = Model.ToList();
    bool canCreate = ViewBag.CanCreateBranch;
    int maxBranches = ViewBag.MaxBranches;
    var categoryCount = branches.Sum(b => b.Categories?.Count ?? 0);
    var productCount = branches.Sum(b => b.Categories?.Sum(c => c.Products?.Count ?? 0) ?? 0);
    var week = ViewBag.Week as Dictionary<int, (MenuInsights.Totals Current, MenuInsights.Totals Previous)> ?? new();
    MenuInsights.Totals Sum(Func<(MenuInsights.Totals Current, MenuInsights.Totals Previous), MenuInsights.Totals> pick) =>
        new(week.Values.Sum(w => pick(w).Views), week.Values.Sum(w => pick(w).DishOpens), week.Values.Sum(w => pick(w).Adds));
    var weekNow = Sum(w => w.Current);
    var weekBefore = Sum(w => w.Previous);
}

<header class="page-head">
    <div>
        <h1>My branches</h1>
        <p>Each branch has its own menu, colours and QR link.</p>
    </div>
    <div class="page-actions">
        @if (canCreate)
        {
            <a asp-controller="Branch" asp-action="Create" class="btn btn-primary">
                <i class="ph ph-plus" aria-hidden="true"></i>New branch
            </a>
        }
        else
        {
            <span class="chip chip--warn"><i class="ph ph-info" aria-hidden="true"></i>All @maxBranches branch slots in use</span>
        }
    </div>
</header>

<div class="stats">
    <div class="stat"><span class="stat-value">@branches.Count<small class="stat-label"> / @maxBranches</small></span><span class="stat-label">Branches</span></div>
    <div class="stat"><span class="stat-value">@categoryCount</span><span class="stat-label">Categories</span></div>
    <div class="stat"><span class="stat-value">@productCount</span><span class="stat-label">Dishes on menus</span></div>
</div>

@if (branches.Any())
{
    <section class="mb-4" aria-labelledby="week-title">
        <h2 id="week-title" class="section-head">Last 7 days <span>@(branches.Count > 1 ? "across all branches" : "")</span></h2>
        <div class="kpi-row">
            <partial name="_Kpi" model="@(new KpiModel("Menu views", weekNow.Views, weekBefore.Views, "previous 7 days"))" />
            <partial name="_Kpi" model="@(new KpiModel("Dishes opened", weekNow.DishOpens, weekBefore.DishOpens, "previous 7 days"))" />
            <partial name="_Kpi" model="@(new KpiModel("Added to lists", weekNow.Adds, weekBefore.Adds, "previous 7 days"))" />
        </div>
    </section>
}

@if (!branches.Any())
{
    <div class="panel">
        <div class="empty">
            <i class="ph ph-storefront" aria-hidden="true"></i>
            <h2>Create your first branch</h2>
            <p>Add the name, address and logo. You'll get a menu link and QR right after.</p>
            @if (canCreate)
            {
                <a asp-controller="Branch" asp-action="Create" class="btn btn-primary mt-2">
                    <i class="ph ph-plus" aria-hidden="true"></i>New branch
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="branch-grid">
        @foreach (var branch in branches)
        {
            var slug = SeoService.Slug(branch.Name);
            var menuUrl = Url.Action("Index", "Menu", new { branchName = slug }, Context.Request.Scheme);
            var cats = branch.Categories?.Count ?? 0;
            var dishes = branch.Categories?.Sum(c => c.Products?.Count ?? 0) ?? 0;

            <article class="branch-card">
                <div class="branch-banner @(string.IsNullOrEmpty(branch.Banner) ? "branch-banner--empty" : "")">
                    @if (!string.IsNullOrEmpty(branch.Banner))
                    {
                        <img src="@branch.Banner" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span aria-hidden="true">@branch.Name.Substring(0, 1)</span>
                    }
                    @if (!string.IsNullOrEmpty(branch.Logo))
                    {
                        <img class="branch-logo" src="@branch.Logo" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span class="branch-logo branch-logo--initial" aria-hidden="true">@branch.Name.Substring(0, 1)</span>
                    }
                </div>

                <div class="branch-body">
                    <h2><a asp-controller="Branch" asp-action="Details" asp-route-id="@branch.Id">@branch.Name</a></h2>
                    <div class="branch-meta"><i class="ph ph-map-pin" aria-hidden="true"></i><span>@branch.Address</span></div>
                    <div class="branch-counts">
                        <span class="chip">@cats @(cats == 1 ? "category" : "categories")</span>
                        <span class="chip">@dishes @(dishes == 1 ? "dish" : "dishes")</span>
                        <span class="chip mono">@branch.Currency</span>
                        @{ var views = week.TryGetValue(branch.Id, out var w) ? w.Current.Views : 0; }
                        <a class="chip chip--link" asp-controller="Branch" asp-action="Insights" asp-route-id="@branch.Id" title="Menu views in the last 7 days">
                            <i class="ph ph-chart-bar" aria-hidden="true"></i>@views.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-GB")) @(views == 1 ? "view" : "views") this week
                        </a>
                    </div>
                </div>

                <div class="branch-foot">
                    <a asp-controller="Branch" asp-action="Details" asp-route-id="@branch.Id" class="btn btn-primary btn-sm">
                        Manage menu
                    </a>
                    <a class="icon-btn" href="@menuUrl" target="_blank" rel="noopener" aria-label="Open the live menu for @branch.Name" title="Open live menu">
                        <i class="ph ph-arrow-square-out" aria-hidden="true"></i>
                    </a>
                    <button type="button" class="icon-btn" data-copy="@menuUrl" data-copy-done="Menu link copied" aria-label="Copy the menu link for @branch.Name" title="Copy menu link">
                        <i class="ph ph-link" aria-hidden="true"></i>
                    </button>
                    <div class="dropdown">
                        <button type="button" class="icon-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions for @branch.Name">
                            <i class="ph ph-dots-three-vertical" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" asp-controller="Branch" asp-action="Insights" asp-route-id="@branch.Id">
                                    <i class="ph ph-chart-bar" aria-hidden="true"></i>Insights
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Branch" asp-action="Print" asp-route-id="@branch.Id">
                                    <i class="ph ph-qr-code" aria-hidden="true"></i>QR &amp; print
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Branch" asp-action="Edit" asp-route-id="@branch.Id">
                                    <i class="ph ph-pencil-simple" aria-hidden="true"></i>Edit details
                                </a>
                            </li>
                            <li>
                                <form asp-controller="Branch" asp-action="Delete" asp-route-id="@branch.Id" method="post"
                                      data-confirm="Delete @branch.Name? Its menu link will stop working.">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="ph ph-trash" aria-hidden="true"></i>Delete branch
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </article>
        }

        @if (canCreate)
        {
            <a class="new-branch" asp-controller="Branch" asp-action="Create">
                <i class="ph ph-plus-circle" aria-hidden="true"></i>
                <strong>New branch</strong>
                <span class="hint">@(maxBranches - branches.Count) of @maxBranches slots left</span>
            </a>
        }
    </div>
}
