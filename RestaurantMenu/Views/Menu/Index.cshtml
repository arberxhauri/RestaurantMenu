@using System.Globalization
@using RestaurantMenu.Helpers
@model Branch
@{
    ViewData["Title"] = Model.Name + " - Menu";
    Layout = null;

    // Theme colours are extracted from the branch logo when it is uploaded.
    var primaryColor = "#C8642A";
    var secondaryColor = "#A4501F";
    var accentColor = "#7E3D17";

    if (!string.IsNullOrEmpty(Model.ThemeColors))
    {
        try
        {
            var colors = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(Model.ThemeColors);
            if (colors != null)
            {
                primaryColor = colors.GetValueOrDefault("Primary") ?? colors.GetValueOrDefault("primary") ?? primaryColor;
                secondaryColor = colors.GetValueOrDefault("Secondary") ?? colors.GetValueOrDefault("secondary") ?? secondaryColor;
                accentColor = colors.GetValueOrDefault("Accent") ?? colors.GetValueOrDefault("accent") ?? accentColor;
            }
        }
        catch { /* keep the defaults */ }
    }

    // Pick readable text for anything filled with the brand colour.
    static double Luminance(string hex)
    {
        try
        {
            hex = hex.TrimStart('#');
            if (hex.Length == 3) hex = string.Concat(hex.Select(c => $"{c}{c}"));
            double Channel(int i)
            {
                var v = int.Parse(hex.Substring(i, 2), NumberStyles.HexNumber) / 255.0;
                return v <= 0.03928 ? v / 12.92 : Math.Pow((v + 0.055) / 1.055, 2.4);
            }
            return 0.2126 * Channel(0) + 0.7152 * Channel(2) + 0.0722 * Channel(4);
        }
        catch { return 0.2; }
    }
    var onBrand = Luminance(primaryColor) > 0.42 ? "#141414" : "#FFFFFF";

    var currentLang = ViewBag.CurrentLanguage as string ?? "en";
    var supportedLanguages = (ViewBag.SupportedLanguages as string[]) ?? new[] { "en" };
    string currencySymbol = ViewBag.CurrencySymbol ?? "";
    var soldOutIds = (ViewBag.SoldOutIds as List<int>) ?? new List<int>();
    // From the table QR code (?t=14). Kept on the language links so switching language keeps the table.
    var table = ViewBag.Table as int?;
    var tableLabel = table == null ? null : TableText.Label(table.Value, currentLang);
    var tableQuery = table == null ? "" : $"&t={table}";

    // Allergens & dietary tags. The filter button only appears once the restaurant has
    // declared something, otherwise every filter would empty the menu.
    var dt = DietaryText.For(currentLang);
    // Format prices in the menu's language so they match the guest list (menu.js uses Intl with <html lang>).
    CultureInfo priceCulture;
    try { priceCulture = CultureInfo.GetCultureInfo(currentLang); } catch (CultureNotFoundException) { priceCulture = CultureInfo.InvariantCulture; }

    var categories = (Model.Categories ?? new List<Category>())
        .Where(c => c.Products != null && c.Products.Any())
        .OrderBy(c => c.Priority)
        .ToList();
    var hasDietary = categories.SelectMany(c => c.Products!).Any(p => p.Allergens != null || p.Diets != Diet.None);

    // Built in MenuController; the theme colour is only known here.
    var seo = (SeoMetadata)ViewData["Seo"]!;
    seo.ThemeColor = primaryColor;

    // Same key as before the redesign so guests keep the lists they saved.
    var storageKey = "menu_fav_" + Model.Name.Replace(" ", "_");

    var ui = currentLang switch
    {
        "sq" => new { Search = "Kërko në menu", NoResults = "Asnjë pjatë nuk përputhet", Items = "artikuj", Item = "artikull", List = "Lista juaj", Empty = "Lista juaj është bosh", EmptyHint = "Shtoni pjata me butonin +", Total = "Totali i përafërt", Clear = "Pastro listën", Save = "Shto në listë", Saved = "Në listë", Close = "Mbyll", Soon = "Menuja po vjen së shpejti", SoonHint = "Restoranti po shton pjatat e tij.", Nutrition = "Vlerat ushqyese", Show = "Tregojani kamarierit", SoldOut = "Ka mbaruar" },
        "it" => new { Search = "Cerca nel menu", NoResults = "Nessun piatto corrisponde", Items = "piatti", Item = "piatto", List = "La tua lista", Empty = "La tua lista è vuota", EmptyHint = "Aggiungi i piatti con il pulsante +", Total = "Totale stimato", Clear = "Svuota lista", Save = "Aggiungi", Saved = "In lista", Close = "Chiudi", Soon = "Menu in arrivo", SoonHint = "Il ristorante sta aggiungendo i suoi piatti.", Nutrition = "Valori nutrizionali", Show = "Mostralo al cameriere", SoldOut = "Esaurito" },
        "de" => new { Search = "Menü durchsuchen", NoResults = "Keine passenden Gerichte", Items = "Gerichte", Item = "Gericht", List = "Deine Liste", Empty = "Deine Liste ist leer", EmptyHint = "Füge Gerichte mit + hinzu", Total = "Geschätzte Summe", Clear = "Liste leeren", Save = "Hinzufügen", Saved = "Auf der Liste", Close = "Schließen", Soon = "Menü folgt in Kürze", SoonHint = "Das Restaurant fügt gerade seine Gerichte hinzu.", Nutrition = "Nährwerte", Show = "Dem Kellner zeigen", SoldOut = "Ausverkauft" },
        "fr" => new { Search = "Rechercher dans le menu", NoResults = "Aucun plat ne correspond", Items = "plats", Item = "plat", List = "Votre liste", Empty = "Votre liste est vide", EmptyHint = "Ajoutez des plats avec le bouton +", Total = "Total estimé", Clear = "Vider la liste", Save = "Ajouter", Saved = "Dans la liste", Close = "Fermer", Soon = "Menu bientôt disponible", SoonHint = "Le restaurant ajoute ses plats.", Nutrition = "Valeurs nutritionnelles", Show = "Montrer au serveur", SoldOut = "Épuisé" },
        "es" => new { Search = "Buscar en el menú", NoResults = "Ningún plato coincide", Items = "platos", Item = "plato", List = "Tu lista", Empty = "Tu lista está vacía", EmptyHint = "Añade platos con el botón +", Total = "Total estimado", Clear = "Vaciar lista", Save = "Añadir", Saved = "En la lista", Close = "Cerrar", Soon = "Menú disponible pronto", SoonHint = "El restaurante está añadiendo sus platos.", Nutrition = "Información nutricional", Show = "Muéstralo al camarero", SoldOut = "Agotado" },
        "tr" => new { Search = "Menüde ara", NoResults = "Eşleşen yemek yok", Items = "ürün", Item = "ürün", List = "Listeniz", Empty = "Listeniz boş", EmptyHint = "Yemekleri + düğmesiyle ekleyin", Total = "Tahmini toplam", Clear = "Listeyi temizle", Save = "Listeye ekle", Saved = "Listede", Close = "Kapat", Soon = "Menü çok yakında", SoonHint = "Restoran yemeklerini ekliyor.", Nutrition = "Besin değerleri", Show = "Garsona gösterin", SoldOut = "Tükendi" },
        _ => new { Search = "Search the menu", NoResults = "No dishes match", Items = "items", Item = "item", List = "Your list", Empty = "Your list is empty", EmptyHint = "Add dishes with the + button", Total = "Estimated total", Clear = "Clear list", Save = "Add to list", Saved = "On your list", Close = "Close", Soon = "Menu coming soon", SoonHint = "The restaurant is adding its dishes.", Nutrition = "Nutrition", Show = "Show this to your server", SoldOut = "Sold out" }
    };
}

<!DOCTYPE html>
<html lang="@currentLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    @await Html.PartialAsync("_SeoMeta", seo)
    @if (!string.IsNullOrEmpty(Model.Banner))
    {
        <link rel="preload" as="image" href="@Model.Banner" fetchpriority="high" />
    }
    <partial name="_HeadAssets" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
    <style>
        :root {
            --brand: @primaryColor;
            --brand-2: @secondaryColor;
            --brand-3: @accentColor;
            --on-brand: @onBrand;
        }
    </style>
</head>
<body class="menu-page"
      data-storage-key="@storageKey"
      data-branch-id="@Model.Id"
      data-event-url="@Url.Action("Event", "Menu")"
      data-currency="@currencySymbol"
      data-label-save="@ui.Save"
      data-label-saved="@ui.Saved"
      data-label-empty="@ui.Empty"
      data-label-empty-hint="@ui.EmptyHint"
      data-label-soldout="@ui.SoldOut"
      data-soldout-ids="@string.Join(",", soldOutIds)"
      data-label-show-dishes="@dt.ShowDishes"
      data-label-show-one-dish="@dt.ShowOneDish"
      data-label-without="@dt.Without">

    <a class="skip-link" href="#menu">Skip to menu</a>

    <header class="m-hero @(string.IsNullOrEmpty(Model.Banner) ? "m-hero--plain" : "")" id="top">
        @if (!string.IsNullOrEmpty(Model.Banner))
        {
            <img class="m-hero-img" src="@Model.Banner" alt="" fetchpriority="high" />
        }
        <div class="m-hero-scrim" aria-hidden="true"></div>

        @if (supportedLanguages.Length > 1)
        {
            <details class="m-lang">
                <summary aria-label="Change language, current: @LanguageHelper.GetLanguageName(currentLang)">
                    <i class="ph ph-translate" aria-hidden="true"></i>
                    <span>@currentLang.ToUpperInvariant()</span>
                    <i class="ph ph-caret-down m-lang-caret" aria-hidden="true"></i>
                </summary>
                <ul class="m-lang-list">
                    @foreach (var lang in supportedLanguages)
                    {
                        <li>
                            <a href="?lang=@lang@tableQuery" lang="@lang" hreflang="@lang" aria-current="@(lang == currentLang ? "true" : null)">
                                @LanguageHelper.GetLanguageName(lang)
                                @if (lang == currentLang)
                                {
                                    <i class="ph ph-check" aria-hidden="true"></i>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </details>
        }

        <div class="m-hero-content">
            @if (!string.IsNullOrEmpty(Model.Logo))
            {
                <img class="m-logo" src="@Model.Logo" alt="@Model.Name logo" width="84" height="84" />
            }
            else
            {
                <span class="m-logo m-logo--initial" aria-hidden="true">@Model.Name.Substring(0, 1)</span>
            }
            <h1 class="m-name" translate="no">@Model.Name</h1>
            @if (tableLabel != null)
            {
                <p class="m-table"><i class="ph-fill ph-armchair" aria-hidden="true"></i><span>@tableLabel</span></p>
            }
            <div class="m-meta">
                <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(Model.Address)" target="_blank" rel="noopener noreferrer">
                    <i class="ph ph-map-pin" aria-hidden="true"></i><span>@Model.Address</span>
                </a>
                <a href="tel:@Model.PhoneNumber">
                    <i class="ph ph-phone" aria-hidden="true"></i><span>@Model.PhoneNumber</span>
                </a>
                @if (Model.HoursEnabled)
                {
                    var openingHours = Model.OpeningHours ?? new List<BranchHours>();
                    var hoursStatus = OpeningHours.GetStatus(openingHours, OpeningHours.Zone(Model.TimeZone), DateTime.UtcNow);
                    @* Status in words and a dot, never colour alone. Opens the week's hours in place. *@
                    <details class="m-hours">
                        <summary class="m-hours-chip @(hoursStatus.IsOpen ? "is-open" : "is-closed")">
                            <span class="m-hours-dot" aria-hidden="true"></span>
                            <span>@OpeningHours.Label(hoursStatus, currentLang)</span>
                            <i class="ph ph-caret-down m-hours-caret" aria-hidden="true"></i>
                        </summary>
                        <div class="m-hours-panel">
                            <h2>@OpeningHours.Title(currentLang)</h2>
                            <ul>
                                @foreach (var day in OpeningHours.Week)
                                {
                                    var isToday = day == hoursStatus.LocalNow.DayOfWeek;
                                    <li class="@(isToday ? "is-today" : "")" aria-current="@(isToday ? "date" : null)">
                                        <span>@OpeningHours.DayName(day, currentLang)@(isToday ? $" · {OpeningHours.Today(currentLang)}" : "")</span>
                                        <span class="tabular">@OpeningHours.DayText(openingHours, day, currentLang)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </details>
                }
            </div>
        </div>
    </header>

    @if (categories.Any())
    {
        <nav class="m-cats" aria-label="Menu sections" data-cats>
            <div class="m-cats-inner">
                <div class="m-cats-scroll" data-cats-scroll>
                    @foreach (var category in categories)
                    {
                        var slug = category.Name.Replace(" ", "-").ToLower();
                        <a class="m-chip" href="#@slug" data-chip="@slug">@TranslationHelper.GetTranslation(category.Name, category.NameTranslations, currentLang)</a>
                    }
                </div>
                @if (hasDietary)
                {
                    <button class="m-icon-btn" type="button" data-filter-toggle aria-haspopup="dialog" aria-controls="filterSheet" aria-label="@dt.Filters">
                        <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>
                        <span class="m-badge tabular" data-filter-count hidden></span>
                    </button>
                }
                <button class="m-icon-btn" type="button" data-search-toggle aria-expanded="false" aria-controls="menuSearch" aria-label="@ui.Search">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                </button>
            </div>
            <div class="m-search" id="menuSearch" hidden>
                <label class="visually-hidden" for="menuSearchInput">@ui.Search</label>
                <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                <input id="menuSearchInput" type="search" placeholder="@(ui.Search)…" autocomplete="off" enterkeyhint="search" data-search-input />
            </div>
        </nav>
    }

    <main class="m-main" id="menu">
        @if (!categories.Any())
        {
            <div class="m-empty">
                <i class="ph ph-cooking-pot" aria-hidden="true"></i>
                <h2>@ui.Soon</h2>
                <p>@ui.SoonHint</p>
            </div>
        }
        else
        {
            <div class="m-filterbar" data-filterbar hidden>
                <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>
                <span data-filter-summary></span>
                <button type="button" class="m-filterbar-clear" data-filter-reset>@dt.Clear</button>
            </div>
            <p class="m-noresults" data-noresults hidden role="status">@ui.NoResults</p>

            @foreach (var category in categories)
            {
                var slug = category.Name.Replace(" ", "-").ToLower();
                var categoryName = TranslationHelper.GetTranslation(category.Name, category.NameTranslations, currentLang);
                var count = category.Products!.Count;

                <section class="m-cat" id="@slug" aria-labelledby="h-@slug" data-cat>
                    <header class="m-cat-head">
                        <h2 id="h-@slug">@categoryName</h2>
                        <span class="m-cat-count">@count @(count == 1 ? ui.Item : ui.Items)</span>
                    </header>

                    <ul class="m-items">
                        @foreach (var product in category.Products!.OrderBy(p => p.DisplayOrder).ThenBy(p => p.Id))
                        {
                            var name = TranslationHelper.GetTranslation(product.Name, product.NameTranslations, currentLang);
                            var desc = TranslationHelper.GetTranslation(product.Description ?? "", product.DescriptionTranslations, currentLang);
                            var nutrition = TranslationHelper.GetTranslation(product.Nutritions ?? "", product.NutritionsTranslations, currentLang);
                            var price = currencySymbol + product.Price.ToString("N2", priceCulture);
                            var hasImage = !string.IsNullOrEmpty(product.Image);
                            var soldOut = !product.IsAvailable;
                            var allergenText = product.Allergens == null ? dt.Unknown
                                : product.Allergens == Allergen.None ? dt.NoneDeclared
                                : $"{dt.Contains}: {string.Join(", ", DietaryText.Names(product.Allergens.Value, currentLang))}";
                            var dietList = Dietary.AllDiets.Where(d => product.Diets.HasFlag(d)).ToList();

                            <li class="m-item @(hasImage ? "has-img" : "") @(soldOut ? "is-soldout" : "")"
                                data-item
                                data-soldout="@(soldOut ? "true" : "false")"
                                data-allergens="@(product.Allergens == null ? -1 : (int)product.Allergens)"
                                data-diets="@((int)product.Diets)"
                                data-allergen-text="@allergenText"
                                data-id="@product.Id"
                                data-name="@name"
                                data-desc="@desc"
                                data-nutrition="@nutrition"
                                data-price="@product.Price.ToString(CultureInfo.InvariantCulture)"
                                data-price-label="@price"
                                data-img="@product.Image"
                                data-search="@($"{name} {desc}".ToLowerInvariant())">
                                <button class="m-item-open" type="button" data-open aria-haspopup="dialog">
                                    <span class="m-item-text">
                                        <span class="m-item-name">@name</span>
                                        @if (!string.IsNullOrEmpty(desc))
                                        {
                                            <span class="m-item-desc">@desc</span>
                                        }
                                        @if (dietList.Any())
                                        {
                                            <span class="m-tags" data-tags>
                                                @foreach (var diet in dietList)
                                                {
                                                    <span class="m-tag m-tag--@diet.ToString().ToLowerInvariant()"><i class="ph @DietaryText.Icon(diet)" aria-hidden="true"></i>@DietaryText.Name(diet, currentLang)</span>
                                                }
                                            </span>
                                        }
                                        @if (product.Allergens is { } declared && declared != Allergen.None)
                                        {
                                            <span class="m-item-allergens">@allergenText</span>
                                        }
                                        @if (!string.IsNullOrEmpty(nutrition))
                                        {
                                            <span class="m-item-nutri"><i class="ph ph-info" aria-hidden="true"></i>@nutrition</span>
                                        }
                                        <span class="m-item-foot">
                                            <span class="m-item-price tabular">@price</span>
                                            @if (soldOut)
                                            {
                                                <span class="m-soldout">@ui.SoldOut</span>
                                            }
                                        </span>
                                    </span>
                                    @if (hasImage)
                                    {
                                        <img class="m-item-img" src="@product.Image" alt="" width="112" height="112" loading="lazy" decoding="async" />
                                    }
                                </button>
                                @if (!soldOut)
                                {
                                    <button class="m-save" type="button" data-save aria-pressed="false" aria-label="@ui.Save: @name">
                                        <i class="ph ph-plus" aria-hidden="true"></i>
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        }
    </main>

    <footer class="m-footer">
        <a class="m-powered" asp-controller="Home" asp-action="Index">
            <partial name="_BrandMark" model="18" />
            <span>Powered by <strong>My Quick Menu</strong></span>
        </a>
        <partial name="_FourCsCredit" />
        <small>&copy; @DateTime.Now.Year <span translate="no">@Model.Name</span></small>
    </footer>

    @* Floating summary of the guest's list. Hidden until something is saved. *@
    <button class="m-fab" type="button" data-fab hidden aria-haspopup="dialog">
        <span class="m-fab-count tabular" data-fab-count>0</span>
        <span>@ui.List</span>
        <span class="m-fab-total tabular" data-fab-total></span>
    </button>

    <dialog class="m-sheet" id="dishSheet" aria-labelledby="dishSheetName" data-dish-sheet>
        <div class="m-sheet-grip" aria-hidden="true"></div>
        <button class="m-sheet-close" type="button" data-close aria-label="@ui.Close"><i class="ph ph-x" aria-hidden="true"></i></button>
        <img class="m-dish-img" data-dish-img alt="" hidden />
        <div class="m-sheet-body">
            <h2 id="dishSheetName" data-dish-name></h2>
            <p class="m-dish-desc" data-dish-desc></p>
            <div class="m-dish-tags" data-dish-tags hidden></div>
            <div class="m-dish-allergens" data-dish-allergens-wrap>
                <span>@dt.Allergens</span>
                <p data-dish-allergens></p>
            </div>
            <div class="m-dish-nutri" data-dish-nutri-wrap hidden>
                <span>@ui.Nutrition</span>
                <p data-dish-nutri></p>
            </div>
            <div class="m-dish-foot">
                <span class="m-dish-price tabular" data-dish-price></span>
                <span class="m-soldout m-soldout--lg" data-dish-soldout hidden>@ui.SoldOut</span>
                <button class="m-btn m-btn--brand" type="button" data-dish-save>
                    <i class="ph ph-plus" aria-hidden="true"></i><span data-dish-save-label>@ui.Save</span>
                </button>
            </div>
        </div>
    </dialog>

    <dialog class="m-sheet" id="listSheet" aria-labelledby="listSheetTitle" data-list-sheet>
        <div class="m-sheet-grip" aria-hidden="true"></div>
        <button class="m-sheet-close" type="button" data-close aria-label="@ui.Close"><i class="ph ph-x" aria-hidden="true"></i></button>
        <div class="m-sheet-body">
            <h2 id="listSheetTitle">@ui.List</h2>
            @if (tableLabel != null)
            {
                <p class="m-list-table"><i class="ph-fill ph-armchair" aria-hidden="true"></i>@tableLabel</p>
            }
            <p class="m-list-hint">@ui.Show</p>
            <ul class="m-list" data-list aria-live="polite"></ul>
            <div class="m-list-foot" data-list-foot>
                <div class="m-list-total">
                    <span>@ui.Total</span>
                    <strong class="tabular" data-list-total></strong>
                </div>
                <button class="m-btn m-btn--ghost" type="button" data-clear>
                    <i class="ph ph-trash" aria-hidden="true"></i>@ui.Clear
                </button>
            </div>
        </div>
    </dialog>

    @if (hasDietary)
    {
        <dialog class="m-sheet" id="filterSheet" aria-labelledby="filterSheetTitle" data-filter-sheet>
            <div class="m-sheet-grip" aria-hidden="true"></div>
            <button class="m-sheet-close" type="button" data-close aria-label="@ui.Close"><i class="ph ph-x" aria-hidden="true"></i></button>
            <div class="m-sheet-body">
                <h2 id="filterSheetTitle">@dt.Filters</h2>
                <fieldset class="m-filter-group">
                    <legend>@dt.ShowOnly</legend>
                    <div class="m-filter-chips">
                        @foreach (var diet in Dietary.AllDiets)
                        {
                            <label class="m-filter-chip">
                                <input type="checkbox" value="@((int)diet)" data-filter-diet />
                                <span><i class="ph @DietaryText.Icon(diet)" aria-hidden="true"></i>@DietaryText.Name(diet, currentLang)</span>
                            </label>
                        }
                    </div>
                </fieldset>
                <fieldset class="m-filter-group">
                    <legend>@dt.HideContaining</legend>
                    <div class="m-filter-chips">
                        @foreach (var allergen in Dietary.AllAllergens)
                        {
                            <label class="m-filter-chip m-filter-chip--avoid">
                                <input type="checkbox" value="@((int)allergen)" data-filter-allergen />
                                <span>@DietaryText.Name(allergen, currentLang)</span>
                            </label>
                        }
                    </div>
                </fieldset>
                <p class="m-filter-note m-filter-note--warn" data-filter-unknown hidden><i class="ph ph-info" aria-hidden="true"></i>@dt.UnknownHidden</p>
                <p class="m-filter-note"><i class="ph ph-warning-circle" aria-hidden="true"></i>@dt.TellServer</p>
                <div class="m-list-foot">
                    <button class="m-btn m-btn--ghost" type="button" data-filter-reset>@dt.Clear</button>
                    <button class="m-btn m-btn--brand" type="button" data-close data-filter-done></button>
                </div>
            </div>
        </dialog>
    }

    <script src="~/js/menu.js" asp-append-version="true" defer></script>
</body>
</html>
