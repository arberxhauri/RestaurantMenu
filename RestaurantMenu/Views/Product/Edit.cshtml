@model Product
@{
    ViewData["Title"] = "Edit " + Model.Name;
}

<ol class="crumbs">
    <li><a asp-controller="Dashboard" asp-action="Index">My branches</a></li>
    <li><a asp-controller="Branch" asp-action="Details" asp-route-id="@Model.BranchId">@(ViewBag.BranchName ?? "Branch")</a></li>
    <li aria-current="page">@Model.Name</li>
</ol>

<header class="page-head">
    <div>
        <h1>Edit dish</h1>
        <p>Changes reach every table as soon as you save.</p>
    </div>
</header>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="BranchId" />
    <partial name="_ProductForm" model="Model" />
</form>

@* Lives outside the main form (forms can't nest); the button inside the form targets it via form="". *@
<form id="removeImageForm" asp-controller="Product" asp-action="RemoveImage" method="post" data-confirm="Remove the current photo of @Model.Name?">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="returnTo" value="edit" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
