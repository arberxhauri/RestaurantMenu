@model Product
@{
    ViewData["Title"] = "New dish";
}

<ol class="crumbs">
    <li><a asp-controller="Dashboard" asp-action="Index">My branches</a></li>
    <li><a asp-controller="Branch" asp-action="Details" asp-route-id="@ViewBag.BranchId">@ViewBag.BranchName</a></li>
    <li aria-current="page">New dish</li>
</ol>

<header class="page-head">
    <div>
        <h1>New dish</h1>
        <p>It appears on the live menu as soon as you save.</p>
    </div>
</header>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="BranchId" value="@ViewBag.BranchId" />
    <partial name="_ProductForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
