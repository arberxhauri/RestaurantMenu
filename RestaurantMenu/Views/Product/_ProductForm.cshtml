@using RestaurantMenu.Helpers
@model Product
@{
    var isEdit = Model?.Id > 0;
    var languages = (ViewBag.SupportedLanguages as string[] ?? new[] { "en" }).Where(l => l != "en").ToArray();
    var names = ViewBag.NameTranslations as Dictionary<string, string> ?? new();
    var descs = ViewBag.DescriptionTranslations as Dictionary<string, string> ?? new();
    var nutris = ViewBag.NutritionTranslations as Dictionary<string, string> ?? new();
    string currency = ViewBag.CurrencySymbol ?? "";
    string Val(Dictionary<string, string> d, string k) => d.TryGetValue(k, out var v) ? v : "";
}

<div class="form-layout">
    <div class="panel">
        <div asp-validation-summary="ModelOnly" class="m-4 mb-0"></div>

        <section class="form-section">
            <h2>Dish</h2>
            <p>Written in English. Translations go below.</p>
            <div class="fields">
                <div class="span-2">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Wood-fired margherita…" autocomplete="off" data-preview-source="name" />
                    <span asp-validation-for="Name"></span>
                </div>
                <div class="span-2">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="San Marzano tomato, fior di latte, basil…" data-preview-source="desc"></textarea>
                    <span class="hint">One or two lines. Guests read this at the table.</span>
                    <span asp-validation-for="Description"></span>
                </div>
                <div class="span-2">
                    <label asp-for="Nutritions" class="form-label">Nutrition &amp; allergens <span class="text-body-secondary fw-normal">(optional)</span></label>
                    <input asp-for="Nutritions" class="form-control" placeholder="e.g. 640 kcal, contains gluten and milk…" autocomplete="off" />
                    <span asp-validation-for="Nutritions"></span>
                </div>
            </div>
        </section>

        <section class="form-section">
            <h2>Placement &amp; price</h2>
            <p>Where the dish sits on the menu and what it costs.</p>
            <div class="fields">
                <div class="span-2">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        @if (!isEdit)
                        {
                            <option value="">Choose a category</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId"></span>
                </div>
                <div>
                    <label asp-for="Price" class="form-label">Price</label>
                    <div class="input-group">
                        @if (!string.IsNullOrEmpty(currency))
                        {
                            <span class="input-group-text">@currency</span>
                        }
                        <input asp-for="Price" class="form-control tabular" type="number" step="0.01" min="0" inputmode="decimal" placeholder="0.00" data-preview-source="price" data-preview-format="money" />
                    </div>
                    <span asp-validation-for="Price"></span>
                </div>
                <div>
                    <label asp-for="DisplayOrder" class="form-label">Order in category</label>
                    <input asp-for="DisplayOrder" class="form-control tabular" type="number" min="0" inputmode="numeric" value="@(Model?.DisplayOrder ?? 0)" />
                    <span class="hint">Lower numbers show first.</span>
                    <span asp-validation-for="DisplayOrder"></span>
                </div>
            </div>
        </section>

        @if (languages.Any())
        {
            <section class="form-section">
                <h2>Translations</h2>
                <p>Leave a field empty and guests see the English text.</p>
                <div class="nav lang-tabs" role="tablist">
                    @for (var i = 0; i < languages.Length; i++)
                    {
                        var lang = languages[i];
                        <button class="nav-link @(i == 0 ? "active" : "")" type="button" role="tab" data-bs-toggle="tab"
                                data-bs-target="#tr-@lang" aria-controls="tr-@lang" aria-selected="@(i == 0 ? "true" : "false")">
                            @LanguageHelper.GetLanguageName(lang) <i class="ph-fill ph-check-circle done" aria-label="has translation" hidden></i>
                        </button>
                    }
                </div>
                <div class="tab-content">
                    @for (var i = 0; i < languages.Length; i++)
                    {
                        var lang = languages[i];
                        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="tr-@lang" role="tabpanel" data-lang-pane>
                            <div class="fields">
                                <div class="span-2">
                                    <label class="form-label" for="tn-@lang">Name</label>
                                    <input id="tn-@lang" type="text" name="translation_name_@lang" class="form-control" lang="@lang" value="@Val(names, lang)" autocomplete="off" />
                                </div>
                                <div class="span-2">
                                    <label class="form-label" for="td-@lang">Description</label>
                                    <textarea id="td-@lang" name="translation_description_@lang" class="form-control" rows="2" lang="@lang">@Val(descs, lang)</textarea>
                                </div>
                                <div class="span-2">
                                    <label class="form-label" for="tu-@lang">Nutrition &amp; allergens</label>
                                    <input id="tu-@lang" type="text" name="translation_nutritions_@lang" class="form-control" lang="@lang" value="@Val(nutris, lang)" autocomplete="off" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>

    <aside class="form-aside">
        <div class="panel form-section">
            <h2>Photo</h2>
            <p>Square or 4:3, at least 800px wide, good light.</p>
            <label class="dropzone dropzone--photo" for="image" data-dropzone="image" data-current="@Model?.Image" tabindex="0">
                <i class="ph ph-camera" aria-hidden="true"></i>
                <strong>@(string.IsNullOrEmpty(Model?.Image) ? "Add a photo" : "Replace photo")</strong>
                <small>Drop an image or click to browse</small>
                <button type="button" class="icon-btn icon-btn--sm dropzone-clear" aria-label="Undo photo change"><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i></button>
            </label>
            <input type="file" name="image" id="image" class="visually-hidden" accept="image/*" />
            @if (isEdit && !string.IsNullOrEmpty(Model?.Image))
            {
                <button type="submit" form="removeImageForm" class="btn btn-danger-quiet btn-sm mt-3">
                    <i class="ph ph-trash" aria-hidden="true"></i>Remove current photo
                </button>
            }
        </div>

        <div>
            <div class="preview-label"><i class="ph ph-eye" aria-hidden="true"></i>How guests see it</div>
            <div class="preview-item">
                <div class="preview-text">
                    <span class="preview-name" data-preview-target="name">Dish name</span>
                    <span class="preview-desc" data-preview-target="desc" data-hide-empty></span>
                    <span class="preview-price tabular" data-preview-target="price" data-currency="@currency">@(currency)0.00</span>
                </div>
                <img data-preview-image alt="" hidden />
                <span class="placeholder" data-preview-placeholder aria-hidden="true"><i class="ph ph-image"></i></span>
            </div>
        </div>
    </aside>
</div>

<div class="form-actions">
    <a asp-controller="Branch" asp-action="Details" asp-route-id="@(Model?.BranchId > 0 ? Model.BranchId : ViewBag.BranchId)" class="btn btn-quiet ms-auto">Cancel</a>
    <button type="submit" class="btn btn-primary">
        <i class="ph ph-check" aria-hidden="true"></i>@(isEdit ? "Save dish" : "Add to menu")
    </button>
</div>
