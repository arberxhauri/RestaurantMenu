@using RestaurantMenu.Helpers
@{
    var groups = ViewBag.Options as List<ProductOptions.GroupForm> ?? new List<ProductOptions.GroupForm>();
    var languages = (ViewBag.SupportedLanguages as string[] ?? new[] { "en" }).Where(l => l != "en").ToArray();
    string currency = ViewBag.CurrencySymbol ?? "";
    var errors = ViewData.ModelState.TryGetValue("Options", out var state) ? state.Errors.Select(e => e.ErrorMessage).ToList() : new List<string>();

    // Field names carry indexes (og-0-o-1-price); site.js renumbers them on submit, so rows
    // can be added and removed freely. data-tr-key / data-tr-for pair each English name
    // with its translation inputs for "Fill translations".
    void Option(ProductOptions.OptionForm o, int g, int j, string key)
    {
        <div class="opt-row" data-option>
            <input class="form-control" name="@ProductOptions.OptionField(g, j, "name")" value="@o.Name" maxlength="@ProductOptions.MaxNameLength"
                   placeholder="Option, e.g. Large" aria-label="Option name" data-tr-key="@key" autocomplete="off" />
            <div class="input-group opt-price">
                <span class="input-group-text">±@currency</span>
                <input class="form-control tabular" type="number" step="0.01" inputmode="decimal" name="@ProductOptions.OptionField(g, j, "price")" value="@o.Price"
                       placeholder="0.00" aria-label="Price change (use a minus for cheaper)" />
            </div>
            <button type="button" class="icon-btn icon-btn--danger" data-remove-option aria-label="Remove this option" title="Remove option"><i class="ph ph-x" aria-hidden="true"></i></button>
            @if (languages.Any())
            {
                <div class="opt-tr">
                    @foreach (var l in languages)
                    {
                        <input class="form-control form-control-sm" name="@ProductOptions.OptionField(g, j, $"tr-{l}")" value="@o.Translations.GetValueOrDefault(l)"
                               lang="@l" data-tr-for="@key" placeholder="@LanguageHelper.GetLanguageName(l)" aria-label="@LanguageHelper.GetLanguageName(l)" autocomplete="off" />
                    }
                </div>
            }
        </div>
    }

    void Group(ProductOptions.GroupForm group, int g, string key)
    {
        <fieldset class="opt-group" data-group>
            <div class="opt-group-head">
                <input class="form-control fw-semibold" name="@ProductOptions.Field(g, "name")" value="@group.Name" maxlength="@ProductOptions.MaxNameLength"
                       placeholder="Group, e.g. Size or Extras" aria-label="Group name" data-tr-key="@key" autocomplete="off" />
                <button type="button" class="icon-btn icon-btn--danger" data-remove-group aria-label="Remove this group" title="Remove group"><i class="ph ph-trash" aria-hidden="true"></i></button>
                @if (languages.Any())
                {
                    <div class="opt-tr">
                        @foreach (var l in languages)
                        {
                            <input class="form-control form-control-sm" name="@ProductOptions.Field(g, $"tr-{l}")" value="@group.Translations.GetValueOrDefault(l)"
                                   lang="@l" data-tr-for="@key" placeholder="@LanguageHelper.GetLanguageName(l)" aria-label="@LanguageHelper.GetLanguageName(l)" autocomplete="off" />
                        }
                    </div>
                }
            </div>
            <div class="opt-rules">
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" name="@ProductOptions.Field(g, "required")" value="true" @(group.Required ? "checked" : "") />
                    <span class="form-check-label">Required</span>
                </label>
                <label class="opt-max">
                    Guests can choose up to
                    <input class="form-control form-control-sm tabular" type="number" min="1" max="@ProductOptions.MaxOptionsPerGroup" name="@ProductOptions.Field(g, "max")" value="@group.Max" />
                </label>
            </div>
            <div class="opt-rows" data-option-rows>
                @for (var j = 0; j < group.Options.Count; j++)
                {
                    Option(group.Options[j], g, j, $"{key}o{j}");
                }
            </div>
            <button type="button" class="btn btn-quiet btn-sm" data-add-option><i class="ph ph-plus" aria-hidden="true"></i>Add option</button>
        </fieldset>
    }
}

<section class="form-section" data-options>
    <h2>Sizes &amp; add-ons</h2>
    <p>Choices guests make on this dish, like a size or extras. The price is added to the dish price; use a minus for a cheaper choice, like a half portion.</p>
    @if (errors.Any())
    {
        <ul class="hours-errors" role="alert">
            @foreach (var e in errors)
            {
                <li>@e</li>
            }
        </ul>
    }
    @if (languages.Any())
    {
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="optShowTr" />
            <label class="form-check-label" for="optShowTr">Show translations</label>
        </div>
    }

    <div class="opt-groups" data-option-groups>
        @for (var g = 0; g < groups.Count; g++)
        {
            Group(groups[g], g, $"g{g}");
        }
    </div>

    <div class="opt-add">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-add-group="size"><i class="ph ph-resize" aria-hidden="true"></i>Add sizes</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-add-group="extras"><i class="ph ph-plus-circle" aria-hidden="true"></i>Add extras</button>
        <button type="button" class="btn btn-quiet btn-sm" data-add-group=""><i class="ph ph-plus" aria-hidden="true"></i>Empty group</button>
    </div>
    <span class="hint">"Required" means guests must pick at least one. "Up to 1" shows round buttons (one choice), more shows tick boxes.</span>

    <template data-group-template>@{ Group(new ProductOptions.GroupForm { Options = { new(), new() } }, 0, "__g__"); }</template>
    <template data-option-template>@{ Option(new ProductOptions.OptionForm(), 0, 0, "__o__"); }</template>
</section>
