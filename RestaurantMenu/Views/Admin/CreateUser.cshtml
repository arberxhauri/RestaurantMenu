@model RestaurantMenu.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "New owner";
}

<ol class="crumbs">
    <li><a asp-action="Index">User management</a></li>
    <li aria-current="page">New owner</li>
</ol>

<header class="page-head">
    <div>
        <h1>New owner</h1>
        <p>A temporary password is shown after you create the account. They'll be asked to change it on first sign-in.</p>
    </div>
</header>

<form asp-action="CreateUser" method="post" class="form-layout form-layout--narrow">
    <div class="panel">
        <div asp-validation-summary="ModelOnly" class="m-4 mb-0"></div>
        <section class="form-section">
            <div class="fields">
                <div class="span-2">
                    <label asp-for="FullName" class="form-label">Full name</label>
                    <input asp-for="FullName" class="form-control form-control-lg" placeholder="e.g. Elira Marku…" autocomplete="off" />
                    <span asp-validation-for="FullName"></span>
                </div>
                <div class="span-2">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="owner@restaurant.al…" autocomplete="off" spellcheck="false" />
                    <span class="hint">They sign in with this address.</span>
                    <span asp-validation-for="Email"></span>
                </div>
                <div>
                    <label asp-for="NIPT" class="form-label">NIPT</label>
                    <input asp-for="NIPT" class="form-control mono" placeholder="L21507023K…" autocomplete="off" spellcheck="false" />
                    <span asp-validation-for="NIPT"></span>
                </div>
                <div>
                    <label asp-for="NumberOfBranches" class="form-label">Branch allowance</label>
                    <input asp-for="NumberOfBranches" class="form-control tabular" type="number" min="1" max="100" value="@(Model?.NumberOfBranches > 0 ? Model.NumberOfBranches : 1)" inputmode="numeric" />
                    <span class="hint">How many branches they can create.</span>
                    <span asp-validation-for="NumberOfBranches"></span>
                </div>
            </div>
        </section>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-quiet">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="ph ph-user-plus" aria-hidden="true"></i>Create owner</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
