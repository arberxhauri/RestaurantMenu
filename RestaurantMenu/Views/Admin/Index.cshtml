@model IEnumerable<ApplicationUser>
@using RestaurantMenu.Services
@using RestaurantMenu.Helpers
@{
    var plans = ViewBag.Plans as Dictionary<string, Entitlements> ?? new();
    int MaxOf(ApplicationUser u) => plans.TryGetValue(u.Id, out var p) ? p.MaxBranches : u.NumberOfBranches;
    string PlanText(ApplicationUser u)
    {
        if (!plans.TryGetValue(u.Id, out var p)) return "Legacy";
        if (p.IsLegacy) return "Legacy";
        return p.Status switch
        {
            SubscriptionStatus.Trialing => p.TrialDaysLeft(DateTime.UtcNow) is { } d ? $"Trial · {d} d left" : "Trial · not started",
            SubscriptionStatus.Active => "Active",
            SubscriptionStatus.PastDue => "Past due",
            SubscriptionStatus.ReadOnly => p.TrialEnded ? "Trial ended" : "Read-only",
            _ => p.Status.ToString()
        };
    }
    string PlanChip(ApplicationUser u) => plans.TryGetValue(u.Id, out var p) && !p.CanWrite ? "chip--danger"
        : plans.TryGetValue(u.Id, out var q) && q.Status is SubscriptionStatus.Trialing or SubscriptionStatus.PastDue ? "chip--warn" : "chip--ok";
    ViewData["Title"] = "User management";
    var users = Model.ToList();
    var used = users.Sum(u => u.Branches?.Count ?? 0);
    var capacity = users.Sum(MaxOf);
    var email = (EmailService)ViewBag.Email;
}

<header class="page-head">
    <div>
        <h1>User management</h1>
        <p>Restaurant owners, their plans, and access.</p>
    </div>
    <div class="page-actions">
        <a asp-action="CreateUser" class="btn btn-primary"><i class="ph ph-user-plus" aria-hidden="true"></i>New owner</a>
    </div>
</header>

@if (users.Where(u => u.AwaitingApproval).ToList() is { Count: > 0 } waiting)
{
    <section class="panel mb-4" aria-labelledby="waiting-title">
        <div class="panel-head"><h2 id="waiting-title" class="h5 m-0">Waiting for approval (@waiting.Count)</h2></div>
        <div class="table-responsive">
            <table class="data-table">
                <thead><tr><th scope="col">Signed up</th><th scope="col">Restaurant</th><th scope="col">Plan</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var u in waiting)
                    {
                        <tr>
                            <td>
                                <strong>@u.FullName</strong><small class="d-block">@u.Email · @u.Country · @(u.Language == "sq" ? "Shqip" : "English")</small>
                                @if (u.ApprovalNote != null) { <span class="chip chip--warn mt-1">@u.ApprovalNote</span> }
                            </td>
                            <td>@u.SignupRestaurantName<small class="d-block text-muted">@u.TermsAcceptedUtc?.ToString("d MMM yyyy HH:mm") UTC</small></td>
                            <td><a asp-action="Plan" asp-route-id="@u.Id" class="chip chip--link">@PlanText(u)</a></td>
                            <td class="text-end text-nowrap">
                                <form asp-action="Approve" method="post" class="d-inline">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary"><i class="ph ph-check" aria-hidden="true"></i>Approve</button>
                                </form>
                                <form asp-action="SoftDeleteUser" method="post" class="d-inline" data-confirm="Decline @u.FullName's signup? The account is removed and the email can't sign up again.">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Decline</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (TempData["InviteLink"] is string inviteLink)
{
    var isReset = (TempData["InviteKind"] as string) == "reset";
    <section class="panel invite-panel mb-4" aria-labelledby="invite-title">
        <div class="panel-body">
            <h2 id="invite-title" class="h5 mb-1"><i class="ph ph-envelope-simple" aria-hidden="true"></i> Send this @(isReset ? "reset link" : "invite") to @TempData["InviteFor"]</h2>
            <p class="hint mt-0 mb-3">@(isReset
                ? $"They open it and choose a new password. It works once, for {AccountTokens.ResetLifespanText}."
                : $"They open it, choose a password and are signed in. It works once, for {AccountTokens.InviteLifespanText}.") Anyone with the link can use it, so send it only to them. It's shown only now, so copy it before leaving this page.</p>
            <div class="input-group">
                <input id="inviteLink" class="form-control mono" value="@inviteLink" readonly aria-label="@(isReset ? "Reset link" : "Invite link")" />
                <button type="button" class="btn btn-primary" data-copy="@inviteLink" data-copy-done="Link copied">
                    <i class="ph ph-copy" aria-hidden="true"></i>Copy link
                </button>
            </div>
        </div>
    </section>
}

<div class="stats">
    <div class="stat"><span class="stat-value">@users.Count</span><span class="stat-label">Owners</span></div>
    <div class="stat"><span class="stat-value">@used</span><span class="stat-label">Branches live</span></div>
    <div class="stat"><span class="stat-value">@capacity</span><span class="stat-label">Branch slots sold</span></div>
</div>

<section class="panel">
    @if (!users.Any())
    {
        <div class="empty">
            <i class="ph ph-users-three" aria-hidden="true"></i>
            <h2>No owners yet</h2>
            <p>Create an owner account. They get an invite link to choose their own password.</p>
            <a asp-action="CreateUser" class="btn btn-primary mt-2"><i class="ph ph-user-plus" aria-hidden="true"></i>New owner</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Owner</th>
                        <th scope="col">NIPT</th>
                        <th scope="col">Branches used</th>
                        <th scope="col">Plan</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        var count = user.Branches?.Count ?? 0;
                        var pct = Math.Min(100, count * 100.0 / Math.Max(MaxOf(user), 1));
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <span class="avatar" aria-hidden="true">@(string.IsNullOrEmpty(user.FullName) ? "?" : user.FullName.Substring(0, 1))</span>
                                    <span>
                                        <strong>@user.FullName</strong><small>@user.Email</small>
                                        @if (user.AwaitingEmail)
                                        {
                                            <span class="chip chip--later mt-1">Signed up · email not confirmed</span>
                                        }
                                        else if (user.AwaitingApproval)
                                        {
                                            <span class="chip chip--warn mt-1">Waiting for approval</span>
                                        }
                                        else if (user.PasswordHash == null)
                                        {
                                            <span class="chip chip--warn mt-1">Invite pending</span>
                                        }
                                        else if (user.SignupSource == SignupSource.SelfServe)
                                        {
                                            <span class="chip chip--accent mt-1">Self-serve</span>
                                        }
                                    </span>
                                </div>
                            </td>
                            <td><span class="mono">@user.NIPT</span></td>
                            <td>
                                <span class="usage">
                                    <span class="usage-bar" aria-hidden="true"><span style="width:@pct.ToString("F0")%"></span></span>
                                    @count / @MaxOf(user)
                                </span>
                            </td>
                            <td>
                                <a asp-action="Plan" asp-route-id="@user.Id" class="chip @PlanChip(user) chip--link" title="Change plan">
                                    <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>@PlanText(user)
                                </a>
                            </td>
                            <td class="text-end text-nowrap">
                                @if (user.PasswordHash == null)
                                {
                                    <form asp-action="ResendInvite" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="icon-btn" aria-label="New invite link for @user.FullName" title="New invite link">
                                            <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="SoftDeleteUser" method="post" class="d-inline" data-confirm="Remove @user.FullName? They'll be signed out and their @count branch menu(s) go offline.">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="icon-btn icon-btn--danger" aria-label="Remove @user.FullName" title="Remove owner">
                                        <i class="ph ph-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="admin-tools">
    <section class="panel" aria-labelledby="email-title">
        <div class="panel-body">
            <h2 id="email-title" class="h5 mb-2"><i class="ph ph-envelope-simple" aria-hidden="true"></i> Email</h2>
            @if (email.IsConfigured)
            {
                <p class="mb-1"><span class="chip chip--ok"><i class="ph ph-check" aria-hidden="true"></i>On</span> Sending through <strong>@email.ProviderName</strong> from <span class="mono">@email.Sender!.Address</span>.</p>
                <p class="hint mt-0">Invites and password reset links go out by email.</p>
            }
            else
            {
                <p class="mb-1"><span class="chip chip--warn"><i class="ph ph-warning" aria-hidden="true"></i>Off</span> @email.Problem</p>
                <p class="hint mt-0">Invite and reset links are shown here to copy and send yourself, and "Forgot password" tells people to ask you. To switch email on, set <span class="mono">Email__From</span> and <span class="mono">Email__ResendApiKey</span> (or <span class="mono">Email__BrevoApiKey</span>) on the server and redeploy.</p>
            }
        </div>
    </section>

    <section class="panel" aria-labelledby="reset-title">
        <div class="panel-body">
            <h2 id="reset-title" class="h5 mb-2"><i class="ph ph-key" aria-hidden="true"></i> Password reset link</h2>
            <p class="hint mt-0 mb-3">For an owner or staff member who can't sign in. @(email.IsConfigured ? "It's emailed to them." : "You get a link to send them.") Works for @AccountTokens.ResetLifespanText.</p>
            <form asp-action="ResetLink" method="post" class="input-group">
                <label class="visually-hidden" for="resetEmail">Their email</label>
                <input id="resetEmail" type="email" name="email" class="form-control" placeholder="their@email.com" autocomplete="off" spellcheck="false" required />
                <button type="submit" class="btn btn-outline-secondary"><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>@(email.IsConfigured ? "Send link" : "Get link")</button>
            </form>
        </div>
    </section>
</div>

@{ var domains = (List<RestaurantMenu.Models.Domain>)ViewBag.Domains; }
@if (domains.Count > 0)
{
    <section class="panel mt-4" aria-labelledby="domainsTitle">
        <div class="panel-head"><h2 id="domainsTitle">Restaurant domains <span class="count">@domains.Count</span></h2></div>
        <div class="panel-body">
            <p class="hint mt-0">Each domain must also be added to the web service in Render (Settings → Custom Domains) for its https certificate, unless Sites__RenderApiKey and Sites__RenderServiceId are set.</p>
            <div class="table-responsive">
                <table class="data-table">
                    <thead><tr><th scope="col">Domain</th><th scope="col">Restaurant</th><th scope="col">Status</th><th scope="col">Added</th></tr></thead>
                    <tbody>
                        @foreach (var d in domains)
                        {
                            <tr>
                                <td><span class="mono">@RestaurantMenu.Helpers.SiteRules.DisplayHost(d.Host)</span></td>
                                <td>@d.Branch?.Name</td>
                                <td>@if (d.Verified) { <span class="chip chip--ok">Connected</span> } else { <span class="chip chip--warn" title="@d.LastError">Waiting for DNS</span> }</td>
                                <td>@d.CreatedUtc.ToString("d MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}
