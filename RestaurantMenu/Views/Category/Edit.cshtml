@model Category
@{
    ViewData["Title"] = "Edit " + Model.Name;
    var count = Model.Products?.Count ?? 0;
}

<ol class="crumbs">
    <li><a asp-controller="Dashboard" asp-action="Index">My branches</a></li>
    <li><a asp-controller="Branch" asp-action="Details" asp-route-id="@Model.BranchId">@(ViewBag.BranchName ?? Model.Branch?.Name ?? "Branch")</a></li>
    <li aria-current="page">@Model.Name</li>
</ol>

<header class="page-head">
    <div>
        <h1>Edit category</h1>
        <p>@count @(count == 1 ? "dish is" : "dishes are") in this category.</p>
    </div>
</header>

<form asp-action="Edit" method="post" class="form-layout form-layout--narrow">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="BranchId" />
    <div class="panel">
        <div asp-validation-summary="ModelOnly" class="m-4 mb-0"></div>
        <section class="form-section">
            <div class="fields">
                <div>
                    <label asp-for="Name" class="form-label">Category name</label>
                    <input asp-for="Name" class="form-control form-control-lg" autocomplete="off" />
                    <span asp-validation-for="Name"></span>
                </div>
                <div>
                    <label asp-for="Priority" class="form-label">Position</label>
                    <input asp-for="Priority" class="form-control form-control-lg tabular" type="number" min="0" max="999" inputmode="numeric" />
                    <span class="hint">Lower shows first. Dragging on the branch page is quicker.</span>
                    <span asp-validation-for="Priority"></span>
                </div>
            </div>
        </section>
        <partial name="_CategoryTranslations" />
    </div>
    <div class="form-actions">
        <a asp-controller="Branch" asp-action="Details" asp-route-id="@Model.BranchId" class="btn btn-quiet">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="ph ph-check" aria-hidden="true"></i>Save category</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
