@model Category
@{
    ViewData["Title"] = "New category";
}

<ol class="crumbs">
    <li><a asp-controller="Dashboard" asp-action="Index">My branches</a></li>
    <li><a asp-controller="Branch" asp-action="Details" asp-route-id="@ViewBag.BranchId">@ViewBag.BranchName</a></li>
    <li aria-current="page">New category</li>
</ol>

<header class="page-head">
    <div>
        <h1>New category</h1>
        <p>A section of the menu, like Starters or Drinks. It's added at the end; drag it into place afterwards.</p>
    </div>
</header>

<form asp-action="Create" method="post" class="form-layout form-layout--narrow">
    <input type="hidden" asp-for="BranchId" value="@ViewBag.BranchId" />
    <div class="panel">
        <div asp-validation-summary="ModelOnly" class="m-4 mb-0"></div>
        <section class="form-section">
            <label asp-for="Name" class="form-label">Category name</label>
            <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Starters…" autocomplete="off" />
            <span asp-validation-for="Name"></span>
        </section>
        <partial name="_CategoryTranslations" />
    </div>
    <div class="form-actions">
        <a asp-controller="Branch" asp-action="Details" asp-route-id="@ViewBag.BranchId" class="btn btn-quiet">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="ph ph-check" aria-hidden="true"></i>Create category</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
