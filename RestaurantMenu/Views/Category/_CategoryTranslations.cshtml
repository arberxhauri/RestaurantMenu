@using RestaurantMenu.Helpers
@{
    var languages = (ViewBag.SupportedLanguages as string[] ?? new[] { "en" }).Where(l => l != "en").ToArray();
    var existing = ViewBag.ExistingTranslations as Dictionary<string, string> ?? new();
}
@if (languages.Any())
{
    <div class="form-section">
        <h2>Translations</h2>
        <p>Leave empty to show the English name.</p>
        <partial name="_TranslateBar" model="@(new RestaurantMenu.ViewModels.TranslateBarModel("category", (int)ViewBag.BranchId, languages,
            new Dictionary<string, string> { ["name"] = "#Name" }))" />
        <div class="fields">
            @foreach (var lang in languages)
            {
                <div>
                    <label class="form-label" for="tn-@lang">@LanguageHelper.GetLanguageName(lang)</label>
                    <input id="tn-@lang" type="text" name="translation_name_@lang" class="form-control" lang="@lang"
                           value="@(existing.TryGetValue(lang, out var v) ? v : "")" autocomplete="off" />
                </div>
            }
        </div>
    </div>
}
