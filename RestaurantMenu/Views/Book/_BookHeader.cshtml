@using RestaurantMenu.Helpers
@model (Branch Branch, string Language, string Subtitle, string? LanguageQuery)
@{
    var languages = SeoLanguages.Of(Model.Branch);
    var mainLanguage = SeoLanguages.Default(Model.Branch);
    // The main language is the bare link, so switching to it never goes through a redirect.
    string Href(string l) => l != mainLanguage ? $"?lang={l}{Model.LanguageQuery}"
        : string.IsNullOrEmpty(Model.LanguageQuery) ? Context.Request.Path.Value! : "?" + Model.LanguageQuery![1..];
}
<header class="b-hero">
    <div class="b-hero-inner">
        @if (!string.IsNullOrEmpty(Model.Branch.Logo))
        {
            <img class="b-logo" src="@ImageUrls.Sized(Model.Branch.Logo, 160)" alt="" width="56" height="56" />
        }
        else
        {
            <span class="b-logo b-logo--initial" aria-hidden="true">@Model.Branch.Name.Substring(0, 1)</span>
        }
        <div class="b-hero-text">
            <h1 translate="no">@Model.Branch.Name</h1>
            <p>@Model.Subtitle</p>
        </div>
        @if (Model.LanguageQuery != null && languages.Length > 1)
        {
            <nav class="b-langs" aria-label="Language">
                @foreach (var l in languages)
                {
                    <a href="@Href(l)" lang="@l" hreflang="@l" aria-current="@(l == Model.Language ? "true" : null)">@l.ToUpperInvariant()</a>
                }
            </nav>
        }
    </div>
</header>
