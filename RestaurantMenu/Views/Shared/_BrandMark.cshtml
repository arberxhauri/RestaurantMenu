@model int
@* The four-tile mark. Ink tiles follow currentColor so it works in light and dark. *@
<svg class="brand-mark" width="@Model" height="@Model" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
    <rect x="4.5" y="4.5" width="15" height="15" rx="4" stroke="currentColor" stroke-width="5"></rect>
    <rect x="26" y="2" width="20" height="20" rx="6.5" fill="currentColor"></rect>
    <rect x="2" y="26" width="20" height="20" rx="6.5" fill="currentColor"></rect>
    <circle class="dot" cx="36" cy="36" r="10"></circle>
</svg>
