@model SeoMetadata
@using RestaurantMenu.Helpers
@*
    Every <head> tag that search engines, social scrapers and AI assistants read.
    Include this inside <head>, after <meta charset> and the viewport tag. Every public page goes
    through here; see docs/SEO-GEO.md.
*@
@{
    // For HtmlValidatorsMiddleware's Last-Modified header (the page is buffered, so headers can still change).
    if (Model.LastModifiedUtc is { } lastModified) Context.Items[RestaurantMenu.Services.HtmlValidatorsMiddleware.LastModifiedKey] = lastModified;
    var xDefault = Model.XDefaultUrl ?? Model.Alternates.FirstOrDefault()?.Url;
}
<title>@Model.Title</title>
<meta name="description" content="@Model.Description" />
<meta name="robots" content="@Model.RobotsContent" />

@if (!string.IsNullOrEmpty(Model.CanonicalUrl))
{
    <link rel="canonical" href="@Model.CanonicalUrl" />
}

@if (Model.Alternates.Count > 1)
{
    foreach (var alternate in Model.Alternates)
    {
        <link rel="alternate" hreflang="@alternate.Language" href="@alternate.Url" />
    }
    <link rel="alternate" hreflang="x-default" href="@xDefault" />
}

<meta property="og:type" content="@Model.OgType" />
<meta property="og:title" content="@Model.Title" />
<meta property="og:description" content="@Model.Description" />
<meta property="og:site_name" content="@Model.SiteName" />
<meta property="og:locale" content="@SeoLanguages.OgLocale(Model.Locale)" />
@if (Model.Alternates.Count > 1)
{
    foreach (var alternate in Model.Alternates.Where(a => a.Language != Model.Locale))
    {
        <meta property="og:locale:alternate" content="@SeoLanguages.OgLocale(alternate.Language)" />
    }
}
@if (!string.IsNullOrEmpty(Model.CanonicalUrl))
{
    <meta property="og:url" content="@Model.CanonicalUrl" />
}
@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <meta property="og:image" content="@Model.ImageUrl" />
    @if (Model.ImageWidth is { } width && Model.ImageHeight is { } height)
    {
        <meta property="og:image:width" content="@width" />
        <meta property="og:image:height" content="@height" />
    }
    <meta property="og:image:alt" content="@(Model.ImageAlt ?? Model.Title)" />
}

<meta name="twitter:card" content="@(string.IsNullOrEmpty(Model.ImageUrl) ? "summary" : "summary_large_image")" />
<meta name="twitter:title" content="@Model.Title" />
<meta name="twitter:description" content="@Model.Description" />
@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <meta name="twitter:image" content="@Model.ImageUrl" />
    <meta name="twitter:image:alt" content="@(Model.ImageAlt ?? Model.Title)" />
}

@if (!string.IsNullOrEmpty(Model.ThemeColor))
{
    <meta name="theme-color" content="@Model.ThemeColor" />
}

@if (Model.FaviconUrl == SeoMetadata.DefaultFavicon)
{
    <link rel="icon" href="/img/brand/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/img/brand/icon-180.png" />
}
else if (!string.IsNullOrEmpty(Model.FaviconUrl))
{
    @* A restaurant's logo: a small copy, not the uploaded original. *@
    <link rel="icon" href="@ImageUrls.Sized(Model.FaviconUrl, 160)" />
    <link rel="apple-touch-icon" href="@ImageUrls.Sized(Model.FaviconUrl, 320)" />
}

@if (!string.IsNullOrEmpty(Model.JsonLd))
{
    @*
        Raw is safe here: JsonLd.Serialize escapes < > & ' " into \uXXXX, so restaurant-supplied
        names and descriptions cannot close this script element.
    *@
    <script type="application/ld+json">@Html.Raw(Model.JsonLd)</script>
}
