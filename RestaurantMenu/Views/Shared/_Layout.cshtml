@{
    // Pages that care about being found supply ViewData["Seo"]. Everything else
    // reaching this layout is a signed-in dashboard screen, so the default is to
    // stay out of the index rather than to leak admin pages into search results.
    var seo = ViewData["Seo"] as SeoMetadata ?? new SeoMetadata
    {
        Title = $"{ViewData["Title"]} - My Quick Menu",
        Description = "Manage your restaurant's digital menus with My Quick Menu.",
        NoIndex = true
    };

    var signedIn = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrEmpty(userName) ? "?" : userName.Substring(0, 1).ToUpperInvariant();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string? Current(params string[] controllers) =>
        controllers.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "page" : null;

    var flashes = new[]
    {
        (Key: "Success", Kind: "ok", Icon: "ph-check-circle"),
        (Key: "Error", Kind: "danger", Icon: "ph-warning-octagon"),
        (Key: "Warning", Kind: "warn", Icon: "ph-warning")
    };
}
<!DOCTYPE html>
<html lang="@seo.Locale">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await Html.PartialAsync("_SeoMeta", seo)
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <partial name="_HeadAssets" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(signedIn ? "app-body" : "public-body")">
    <a class="skip-link" href="#main">Skip to content</a>

    @if (signedIn)
    {
        <div class="app">
            <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-label="Main navigation">
                <div class="sidebar-head">
                    <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                        <partial name="_BrandMark" model="26" />
                        <span class="brand-word">myquick<em>menu</em></span>
                    </a>
                    <button type="button" class="icon-btn d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close navigation">
                        <i class="ph ph-x" aria-hidden="true"></i>
                    </button>
                </div>

                <nav class="sidebar-nav">
                    @if (User.IsInRole("OWNER"))
                    {
                        <a asp-controller="Dashboard" asp-action="Index" aria-current="@Current("Dashboard", "Branch", "Category", "Product")">
                            <i class="ph ph-storefront" aria-hidden="true"></i>My branches
                        </a>
                    }
                    @if (User.IsInRole("ADMIN"))
                    {
                        <a asp-controller="Admin" asp-action="Index" aria-current="@Current("Admin")">
                            <i class="ph ph-users-three" aria-hidden="true"></i>User management
                        </a>
                    }
                    <a asp-controller="Account" asp-action="ChangePassword" aria-current="@Current("Account")">
                        <i class="ph ph-key" aria-hidden="true"></i>Password
                    </a>
                </nav>

                <div class="sidebar-foot">
                    <div class="sidebar-user">
                        <span class="avatar" aria-hidden="true">@initial</span>
                        <span class="sidebar-user-name">
                            <small>Signed in as</small>
                            <span>@userName</span>
                        </span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="icon-btn" aria-label="Sign out" title="Sign out">
                            <i class="ph ph-sign-out" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            </aside>

            <div class="app-main">
                <header class="topbar d-lg-none">
                    <button type="button" class="icon-btn" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open navigation">
                        <i class="ph ph-list" aria-hidden="true"></i>
                    </button>
                    <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                        <partial name="_BrandMark" model="22" />
                        <span class="brand-word">myquick<em>menu</em></span>
                    </a>
                    <span class="avatar" aria-hidden="true">@initial</span>
                </header>

                <main id="main" class="content">
                    <div class="flash-stack" aria-live="polite">
                        @foreach (var f in flashes)
                        {
                            if (TempData[f.Key] is string message)
                            {
                                <div class="flash flash--@f.Kind" role="status">
                                    <i class="ph @f.Icon" aria-hidden="true"></i>
                                    <p>@message</p>
                                    @if (f.Key == "Success" && TempData["UndoUrl"] is string undoUrl)
                                    {
                                        <form action="@undoUrl" method="post" class="flash-undo">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                <i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>Undo
                                            </button>
                                        </form>
                                    }
                                    <button type="button" class="icon-btn icon-btn--sm" data-dismiss-flash aria-label="Dismiss">
                                        <i class="ph ph-x" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                        }
                    </div>
                    @RenderBody()
                </main>

                <footer class="app-footer">
                    <span>&copy; @DateTime.Now.Year My Quick Menu</span>
                    <partial name="_FourCsCredit" />
                </footer>
            </div>
        </div>
    }
    else
    {
        <header class="public-header">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <partial name="_BrandMark" model="26" />
                <span class="brand-word">myquick<em>menu</em></span>
            </a>
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
        </header>
        <main id="main" class="public-main">
            @RenderBody()
        </main>
        <footer class="app-footer public-footer">
            <span>&copy; @DateTime.Now.Year My Quick Menu</span>
            <partial name="_FourCsCredit" />
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
