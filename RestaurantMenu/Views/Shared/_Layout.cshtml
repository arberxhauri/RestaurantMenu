@inject RestaurantMenu.Services.BackofficeShell Shell
@{
    // Pages that care about being found supply ViewData["Seo"]. Everything else
    // reaching this layout is a signed-in dashboard screen, so the default is to
    // stay out of the index rather than to leak admin pages into search results.
    var seo = ViewData["Seo"] as SeoMetadata ?? new SeoMetadata
    {
        Title = $"{ViewData["Title"]} - My Quick Menu",
        Description = "Manage your restaurant's digital menus with My Quick Menu.",
        NoIndex = true,
        NoFollow = true
    };

    // Public marketing pages on this layout (pricing, privacy, terms) get the marketing header and footer.
    var marketing = ViewData["Marketing"] as RestaurantMenu.Services.MarketingChrome;
    var signedIn = User.Identity?.IsAuthenticated == true && marketing == null;
    // Side panel, current branch and branch switcher (docs/PLAN-backoffice.md, phase 1).
    var shell = signedIn ? await Shell.BuildAsync() : null;

    var flashes = new[]
    {
        (Key: "Success", Kind: "ok", Icon: "ph-check-circle"),
        (Key: "Error", Kind: "danger", Icon: "ph-warning-octagon"),
        (Key: "Warning", Kind: "warn", Icon: "ph-warning")
    };
}
<!DOCTYPE html>
<html lang="@seo.Locale">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await Html.PartialAsync("_SeoMeta", seo)
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <partial name="_HeadAssets" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    @if (marketing != null)
    {
        <link rel="stylesheet" href="~/css/marketing-chrome.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/marketing-pages.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(signedIn ? "app-body" : "public-body")">
    @if (marketing == null)
    {
        <a class="skip-link" href="#main">Skip to content</a>
    }

    @if (signedIn && shell != null)
    {
        <div class="app">
            <partial name="_BackofficeSidebar" model="shell" />

            <div class="app-main">
                <partial name="_BackofficeTopbar" model="shell" />

                <main id="main" class="content">
                    <div class="flash-stack" aria-live="polite">
                        @foreach (var f in flashes)
                        {
                            if (TempData[f.Key] is string message)
                            {
                                <div class="flash flash--@f.Kind" role="status">
                                    <i class="ph @f.Icon" aria-hidden="true"></i>
                                    <p>@message</p>
                                    @if (f.Key == "Success" && TempData["UndoUrl"] is string undoUrl)
                                    {
                                        <form action="@undoUrl" method="post" class="flash-undo">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                <i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>Undo
                                            </button>
                                        </form>
                                    }
                                    <button type="button" class="icon-btn icon-btn--sm" data-dismiss-flash aria-label="Dismiss">
                                        <i class="ph ph-x" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                        }
                        <partial name="_PlanNotice" />
                    </div>
                    @RenderBody()
                </main>

                <footer class="app-footer">
                    <span>&copy; @DateTime.Now.Year My Quick Menu</span>
                    <partial name="_FourCsCredit" />
                </footer>
            </div>
        </div>
        <partial name="_CommandPalette" model="shell" />
    }
    else if (marketing != null)
    {
        <div class="mchrome">
            <partial name="_MarketingHeader" model="marketing" />
        </div>
        <main id="main" class="public-main">
            @RenderBody()
        </main>
        <div class="mchrome">
            <partial name="_MarketingFooter" model="marketing" />
        </div>
    }
    else
    {
        <header class="public-header">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <partial name="_BrandMark" model="26" />
                <span class="brand-word">myquick<em>menu</em></span>
            </a>
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">@(ViewData["SignInLabel"] as string ?? "Sign in")</a>
        </header>
        <main id="main" class="public-main">
            @RenderBody()
        </main>
        <footer class="app-footer public-footer">
            <span>&copy; @DateTime.Now.Year My Quick Menu</span>
            <partial name="_FourCsCredit" />
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (signedIn)
    {
        <script src="~/js/shell.js" asp-append-version="true"></script>
    }
    @if (marketing != null)
    {
        <script src="~/js/landing.js" asp-append-version="true" defer></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
