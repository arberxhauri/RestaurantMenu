@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="error-page">
    <i class="ph ph-cooking-pot" aria-hidden="true"></i>
    <h1>Something went wrong</h1>
    <p>That one's on us. Try again in a moment. If it keeps happening, send us the reference below.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p><span class="chip mono">Ref @Model.RequestId</span></p>
    }
    <div class="page-actions justify-content-center mt-2">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
</div>
