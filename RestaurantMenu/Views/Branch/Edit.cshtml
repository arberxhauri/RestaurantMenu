@model Branch
@{
    ViewData["Title"] = "Edit " + Model.Name;
}

<ol class="crumbs">
    <li><a asp-controller="Dashboard" asp-action="Index">My branches</a></li>
    <li><a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></li>
    <li aria-current="page">Edit</li>
</ol>

<header class="page-head">
    <div>
        <h1>Edit branch</h1>
        <p>Name, contact details, languages and branding for @Model.Name.</p>
    </div>
</header>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="UserId" />
    <partial name="_BranchForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/device.css" asp-append-version="true" />
}
