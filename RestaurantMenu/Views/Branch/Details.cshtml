@using RestaurantMenu.Helpers
@using RestaurantMenu.ViewModels
@model Branch
@{
    ViewData["Title"] = Model.Name;
    var currency = CurrencyHelper.GetCurrencySymbol(Model.Currency);
    var categories = (Model.Categories ?? new List<Category>()).OrderBy(c => c.Priority).ToList();
    var dishCount = categories.Sum(c => c.Products?.Count ?? 0);
    var soldOutCount = categories.Sum(c => c.Products?.Count(p => !p.IsAvailable) ?? 0);
    var undeclaredCount = categories.Sum(c => c.Products?.Count(p => p.Allergens == null) ?? 0);
    var menuUrl = Url.Action("Index", "Menu", new { branchName = SeoService.Slug(Model.Name) }, Context.Request.Scheme);
    var languages = Model.SupportedLanguages.Split(',', StringSplitOptions.RemoveEmptyEntries);
    // Only what this person may do is shown; every action checks again on the server.
    var role = ViewBag.Role is BranchRole r ? r : BranchRole.None;
    bool Can(BranchPermission p) => BranchAccess.Allows(role, p);
    var team = ViewBag.Team as List<TeamMemberRow>;
}

<ol class="crumbs">
    <li><a asp-controller="Dashboard" asp-action="Index">My branches</a></li>
    <li aria-current="page">@Model.Name</li>
</ol>

<section class="branch-hero">
    @if (!string.IsNullOrEmpty(Model.Banner))
    {
        <img class="cover" src="@Model.Banner" alt="" />
    }
    @if (!string.IsNullOrEmpty(Model.Logo))
    {
        <img class="branch-logo" src="@Model.Logo" alt="" />
    }
    else
    {
        <span class="branch-logo branch-logo--initial" aria-hidden="true">@Model.Name.Substring(0, 1)</span>
    }
    <div class="branch-hero-text">
        <h1>@Model.Name</h1>
        <div class="branch-hero-meta">
            <span><i class="ph ph-map-pin" aria-hidden="true"></i>@Model.Address</span>
            <span><i class="ph ph-phone" aria-hidden="true"></i>@Model.PhoneNumber</span>
            <span><i class="ph ph-translate" aria-hidden="true"></i>@string.Join(", ", languages.Select(LanguageHelper.GetLanguageName))</span>
            @if (role is BranchRole.Manager or BranchRole.Editor)
            {
                <span class="role-chip"><i class="ph ph-user-circle" aria-hidden="true"></i>You're @(role == BranchRole.Manager ? "a manager" : "an editor") here</span>
            }
        </div>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" href="@menuUrl" target="_blank" rel="noopener">
            <i class="ph ph-arrow-square-out" aria-hidden="true"></i>Live menu
        </a>
        @if (Model.OrderingEnabled && Can(BranchPermission.Kitchen))
        {
            <a class="btn btn-primary btn-sm" asp-controller="Kitchen" asp-action="Index" asp-route-id="@Model.Id">
                <i class="ph ph-cooking-pot" aria-hidden="true"></i>Kitchen
            </a>
        }
        @if (Can(BranchPermission.Bookings))
        {
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Bookings" asp-action="Index" asp-route-id="@Model.Id">
                <i class="ph ph-calendar-check" aria-hidden="true"></i>Bookings
            </a>
        }
        @if (Can(BranchPermission.EditBranch))
        {
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Website" asp-action="Index" asp-route-id="@Model.Id">
                <i class="ph ph-globe-simple" aria-hidden="true"></i>Website
            </a>
        }
        @if (Can(BranchPermission.EditBranch))
        {
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Tables" asp-action="Index" asp-route-id="@Model.Id">
                <i class="ph ph-armchair" aria-hidden="true"></i>Tables &amp; ordering
            </a>
        }
        @if (Can(BranchPermission.ViewInsights))
        {
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Sales" asp-action="Index" asp-route-id="@Model.Id">
                <i class="ph ph-receipt" aria-hidden="true"></i>Sales
            </a>
        }
        @if (Can(BranchPermission.Stock))
        {
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Stock" asp-action="Index" asp-route-id="@Model.Id">
                <i class="ph ph-package" aria-hidden="true"></i>Stock
            </a>
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Shifts" asp-action="Index" asp-route-id="@Model.Id">
                <i class="ph ph-calendar-blank" aria-hidden="true"></i>Shifts
            </a>
        }
        @if (Can(BranchPermission.ViewInsights))
        {
            <a class="btn btn-outline-secondary btn-sm" asp-action="Insights" asp-route-id="@Model.Id">
                <i class="ph ph-chart-bar" aria-hidden="true"></i>Insights
            </a>
        }
        @if (Can(BranchPermission.Print))
        {
            <a class="btn btn-outline-secondary btn-sm" asp-action="Print" asp-route-id="@Model.Id">
                <i class="ph ph-qr-code" aria-hidden="true"></i>QR &amp; print
            </a>
        }
        <button type="button" class="btn btn-outline-secondary btn-sm" data-copy="@menuUrl" data-copy-done="Menu link copied">
            <i class="ph ph-link" aria-hidden="true"></i>Copy link
        </button>
        @if (Can(BranchPermission.EditBranch))
        {
            <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="ph ph-pencil-simple" aria-hidden="true"></i>Edit
            </a>
        }
    </div>
</section>

@Html.AntiForgeryToken()

<div class="row g-4">
    <div class="col-lg-5 col-xl-4">
        <section class="panel" aria-labelledby="cat-title">
            <header class="panel-head">
                <h2 id="cat-title">Categories <span class="count">@categories.Count</span></h2>
                @if (Can(BranchPermission.EditCategories))
                {
                    <a asp-controller="Category" asp-action="Create" asp-route-branchId="@Model.Id" class="btn btn-outline-secondary btn-sm">
                        <i class="ph ph-plus" aria-hidden="true"></i>Add
                    </a>
                }
            </header>

            @if (!categories.Any())
            {
                <div class="empty empty--compact">
                    <i class="ph ph-list-bullets" aria-hidden="true"></i>
                    <h3>No categories yet</h3>
                    <p>@(Can(BranchPermission.EditCategories) ? "Start with sections like Starters, Mains and Drinks." : "A manager or the owner adds the menu's sections.")</p>
                </div>
            }
            else
            {
                @* Editors see the categories but can't change or reorder them. *@
                var canCategories = Can(BranchPermission.EditCategories);
                <ul class="row-list" data-sortable="@(canCategories ? Url.Action("UpdatePriorities", "Category") : null)" data-sortable-item="data-category-id"
                    data-sortable-key="categoryIds" data-sortable-state="[data-sort-state]">
                    @for (var i = 0; i < categories.Count; i++)
                    {
                        var category = categories[i];
                        var count = category.Products?.Count ?? 0;
                        <li class="row-item" data-category-id="@category.Id" data-sort-name="@category.Name">
                            @if (canCategories)
                            {
                                <button type="button" class="drag-handle" aria-label="Move @category.Name (drag, or use the arrow keys)" title="Drag to reorder">
                                    <i class="ph ph-dots-six-vertical" aria-hidden="true"></i>
                                </button>
                            }
                            <div class="row-main">
                                <div class="row-title">@category.Name</div>
                                <div class="row-sub">Position <span data-position>@(i + 1)</span>, @count @(count == 1 ? "dish" : "dishes")</div>
                                @if (ServingTimes.IsRestricted(category))
                                {
                                    <div class="row-sub"><i class="ph ph-clock" aria-hidden="true"></i> @ServingTimes.Schedule(category, "en")@(category.HideWhenUnavailable ? ", hidden outside" : "")</div>
                                }
                            </div>
                            @if (canCategories)
                            {
                                <div class="row-actions">
                                    <a asp-controller="Category" asp-action="Edit" asp-route-id="@category.Id" class="icon-btn" aria-label="Edit @category.Name" title="Edit">
                                        <i class="ph ph-pencil-simple" aria-hidden="true"></i>
                                    </a>
                                    <form asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" method="post"
                                          data-confirm="Delete @category.Name and its @count @(count == 1 ? "dish" : "dishes")?">
                                        <button type="submit" class="icon-btn icon-btn--danger" aria-label="Delete @category.Name" title="Delete">
                                            <i class="ph ph-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </li>
                    }
                </ul>
                @if (canCategories)
                {
                    <div class="panel-body pt-2 pb-3">
                        <p class="save-state m-0" data-sort-state aria-live="polite">Drag the handle to change the order guests see.</p>
                    </div>
                }
            }
        </section>
    </div>

    <div class="col-lg-7 col-xl-8">
        <section class="panel" aria-labelledby="dish-title">
            <header class="panel-head">
                <h2 id="dish-title">Dishes <span class="count">@dishCount</span></h2>
                @if (undeclaredCount > 0)
                {
                    <span class="chip ms-auto" title="Open a dish and fill in Allergens &amp; dietary tags">
                        <i class="ph ph-warning-circle" aria-hidden="true"></i>@undeclaredCount without allergens
                    </span>
                }
                <span class="chip chip--warn @(undeclaredCount > 0 ? "" : "ms-auto")" data-soldout-count aria-live="polite" @(soldOutCount == 0 ? "hidden" : "")>@soldOutCount sold out</span>
                @if (categories.Any())
                {
                    <a asp-controller="Product" asp-action="Create" asp-route-branchId="@Model.Id" class="btn btn-primary btn-sm">
                        <i class="ph ph-plus" aria-hidden="true"></i>Add dish
                    </a>
                }
            </header>

            @if (dishCount == 0)
            {
                <div class="empty empty--compact">
                    <i class="ph ph-bowl-food" aria-hidden="true"></i>
                    <h3>No dishes yet</h3>
                    <p>@(categories.Any() ? "Add your first dish with a photo and price." : "Create a category first, then add dishes to it.")</p>
                </div>
            }
            else
            {
                <div class="scroll-panel">
                    @foreach (var category in categories.Where(c => c.Products != null && c.Products.Any()))
                    {
                        @* Each category's dishes reorder on their own (DisplayOrder is per category). *@
                        <div class="dish-group" data-sortable="@Url.Action("UpdateOrder", "Product")" data-sortable-item="data-product-id"
                             data-sortable-key="productIds" data-sortable-extra='{"categoryId":@category.Id}'>
                            <h3 class="dish-group-title">@category.Name</h3>
                            @foreach (var product in category.Products!.OrderBy(p => p.DisplayOrder).ThenBy(p => p.Id))
                            {
                                <div class="dish @(product.IsAvailable ? "" : "is-soldout")" data-dish data-product-id="@product.Id" data-sort-name="@product.Name">
                                    <button type="button" class="drag-handle" aria-label="Move @product.Name (drag, or use the arrow keys)" title="Drag to reorder">
                                        <i class="ph ph-dots-six-vertical" aria-hidden="true"></i>
                                    </button>
                                    <div class="dish-thumb">
                                        @if (!string.IsNullOrEmpty(product.Image))
                                        {
                                            <img src="@product.Image" alt="" loading="lazy" />
                                            <form asp-controller="Product" asp-action="RemoveImage" method="post" data-confirm="Remove the photo of @product.Name?">
                                                <input type="hidden" name="id" value="@product.Id" />
                                                <input type="hidden" name="returnTo" value="branch" />
                                                <button type="submit" class="icon-btn icon-btn--sm" aria-label="Remove photo of @product.Name" title="Remove photo">
                                                    <i class="ph ph-x" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="placeholder" aria-hidden="true"><i class="ph ph-image"></i></span>
                                        }
                                    </div>
                                    <div class="dish-main">
                                        <div class="dish-name">
                                            @product.Name
                                            <span class="chip chip--warn dish-soldout" data-soldout-chip @(product.IsAvailable ? "hidden" : "")>Sold out</span>
                                            @if (product.Badge != DishBadge.None)
                                            {
                                                <span class="chip chip--accent dish-badge">@Highlights.BadgeName(product.Badge, "en")</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <div class="dish-desc">@product.Description</div>
                                        }
                                        @if (product.Allergens == null)
                                        {
                                            <a class="dish-flag" asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id"><i class="ph ph-warning-circle" aria-hidden="true"></i>No allergen info</a>
                                        }
                                    </div>
                                    <span class="dish-price">@currency@product.Price.ToString("N2")</span>
                                    @* Works as a plain form post without JavaScript; site.js turns it into an instant toggle.
                                       The hidden field carries the state the dish should switch to. *@
                                    <form asp-controller="Product" asp-action="ToggleAvailability" asp-route-id="@product.Id" method="post" data-availability data-name="@product.Name">
                                        <input type="hidden" name="isAvailable" value="@(product.IsAvailable ? "false" : "true")" />
                                        <button type="submit" class="avail-switch" role="switch"
                                                aria-checked="@(product.IsAvailable ? "true" : "false")"
                                                aria-label="Available: @product.Name"
                                                title="@(product.IsAvailable ? "Available. Tap to mark sold out" : "Sold out. Tap to make available")">
                                            <span class="avail-thumb" aria-hidden="true"></span>
                                        </button>
                                    </form>
                                    <div class="row-actions">
                                        @* Recommend at the top of the menu. A plain form post without JavaScript; site.js makes it instant. *@
                                        <form asp-controller="Product" asp-action="ToggleFeatured" asp-route-id="@product.Id" method="post" data-featured data-name="@product.Name">
                                            <input type="hidden" name="isFeatured" value="@(product.IsFeatured ? "false" : "true")" />
                                            <button type="submit" class="icon-btn star-btn" aria-pressed="@(product.IsFeatured ? "true" : "false")"
                                                    aria-label="Recommend @product.Name at the top of the menu"
                                                    title="@(product.IsFeatured ? "Recommended. Tap to remove" : "Recommend at the top of the menu")">
                                                <i class="@(product.IsFeatured ? "ph-fill" : "ph") ph-star" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id" class="icon-btn" aria-label="Edit @product.Name" title="Edit">
                                            <i class="ph ph-pencil-simple" aria-hidden="true"></i>
                                        </a>
                                        @if (Can(BranchPermission.DeleteDishes))
                                        {
                                            <form asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id" method="post" data-confirm="Delete @product.Name from the menu?">
                                                <button type="submit" class="icon-btn icon-btn--danger" aria-label="Delete @product.Name" title="Delete">
                                                    <i class="ph ph-trash" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>

@if (ViewBag.FeedbackSummary is RestaurantMenu.Services.FeedbackService.Summary fbs)
{
    var latest = (List<Feedback>)ViewBag.FeedbackLatest;
    <section class="panel mt-4" id="feedback" aria-labelledby="fb-title">
        <header class="panel-head">
            <h2 id="fb-title">Guest feedback</h2>
            <div class="panel-actions">
                <span class="fb-summary">
                    @if (fbs.Count > 0) { <strong>@fbs.Average.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) ★</strong> <span>from @fbs.Count in 30 days</span> }
                    else { <span>No ratings in 30 days</span> }
                    @if (fbs.Unread > 0) { <span class="chip chip--accent">@fbs.Unread new</span> }
                </span>
                <a class="btn btn-outline-secondary btn-sm" asp-controller="Feedback" asp-action="Index" asp-route-id="@Model.Id">All feedback</a>
            </div>
        </header>
        <div class="panel-body fb-list fb-list--compact">
            @if (latest.Count == 0)
            {
                <p class="hint m-0">@(Model.FeedbackEnabled ? "Guests rate their visit at the bottom of the menu. Their ratings show here." : "The rating prompt is off. Switch it on in All feedback → Settings.")</p>
            }
            @foreach (var f in latest)
            {
                var fbItem = (f, Model, false, "all");
                <partial name="~/Views/Feedback/_FeedbackItem.cshtml" model="fbItem" />
            }
        </div>
    </section>
}

@if (team != null)
{
    <section class="panel mt-4 team" id="team" aria-labelledby="team-title">
        <header class="panel-head">
            <h2 id="team-title">Team <span class="count">@team.Count</span></h2>
        </header>
        <div class="panel-body">
            <p class="team-intro">
                Let managers and waiters update the menu with their own login.
                <strong>Editors</strong> add and change dishes and mark them sold out.
                <strong>Managers</strong> can also change categories, branch details, hours and brand, and see Insights and QR codes.
                Only you manage the team and can delete the branch.
            </p>

            @if (TempData["TeamInviteLink"] is string teamLink)
            {
                <div class="flash flash--warn team-link" role="status">
                    <i class="ph ph-envelope-simple" aria-hidden="true"></i>
                    <div>
                        <strong>Send this invite link to @TempData["TeamInviteFor"]</strong>
                        <p class="m-0">Send it yourself (WhatsApp, SMS…). It works once, for @RestaurantMenu.Services.AccountTokens.InviteLifespanText. Anyone with the link can join, so send it only to them.</p>
                        <div class="team-link-row">
                            <input class="form-control form-control-sm mono" value="@teamLink" readonly aria-label="Invite link" />
                            <button type="button" class="btn btn-primary btn-sm" data-copy="@teamLink" data-copy-done="Invite link copied"><i class="ph ph-copy" aria-hidden="true"></i>Copy</button>
                        </div>
                    </div>
                </div>
            }

            <form asp-controller="Team" asp-action="Invite" method="post" class="team-invite">
                <input type="hidden" name="branchId" value="@Model.Id" />
                <label class="team-field team-field--email">
                    <span class="form-label">Email</span>
                    <input class="form-control" type="email" name="email" required maxlength="256" autocomplete="off" placeholder="name@example.com" />
                </label>
                <label class="team-field">
                    <span class="form-label">Name <span class="text-body-secondary fw-normal">(optional)</span></span>
                    <input class="form-control" type="text" name="name" maxlength="100" autocomplete="off" />
                </label>
                <label class="team-field">
                    <span class="form-label">Role</span>
                    <select class="form-select" name="role">
                        <option value="@BranchMemberRole.Editor">Editor</option>
                        <option value="@BranchMemberRole.Manager">Manager</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary"><i class="ph ph-user-plus" aria-hidden="true"></i>Invite</button>
            </form>

            @if (!team.Any())
            {
                <p class="hint m-0">No one else has access yet.</p>
            }
            else
            {
                <ul class="team-list">
                    @foreach (var member in team)
                    {
                        <li class="team-member">
                            <span class="team-avatar" aria-hidden="true">@member.Name.Substring(0, 1).ToUpperInvariant()</span>
                            <div class="team-who">
                                <strong>@member.Name</strong>
                                <span>@member.Email</span>
                            </div>
                            @if (member.Pending)
                            {
                                <span class="chip chip--warn">Invite pending</span>
                                <form asp-controller="Team" asp-action="ResendInvite" method="post">
                                    <input type="hidden" name="memberId" value="@member.Id" />
                                    <button type="submit" class="btn btn-quiet btn-sm">New invite link</button>
                                </form>
                            }
                            <form asp-controller="Team" asp-action="ChangeRole" method="post" data-autosubmit>
                                <input type="hidden" name="memberId" value="@member.Id" />
                                <label class="visually-hidden" for="role-@member.Id">Role of @member.Name</label>
                                <select class="form-select form-select-sm" id="role-@member.Id" name="role">
                                    <option value="@BranchMemberRole.Editor" selected="@(member.Role == BranchMemberRole.Editor)">Editor</option>
                                    <option value="@BranchMemberRole.Manager" selected="@(member.Role == BranchMemberRole.Manager)">Manager</option>
                                </select>
                                <noscript><button type="submit" class="btn btn-quiet btn-sm">Save</button></noscript>
                            </form>
                            <form asp-controller="Team" asp-action="Remove" method="post" data-confirm="Remove @member.Name from this branch? They lose access right away.">
                                <input type="hidden" name="memberId" value="@member.Id" />
                                <button type="submit" class="icon-btn icon-btn--danger" aria-label="Remove @member.Name" title="Remove"><i class="ph ph-user-minus" aria-hidden="true"></i></button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
}

@section Scripts {
    <script src="@("https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js")"></script>
}
