@model Branch
@{
    ViewData["Title"] = "New branch";
}

<ol class="crumbs">
    <li><a asp-controller="Dashboard" asp-action="Index">My branches</a></li>
    <li aria-current="page">New branch</li>
</ol>

<header class="page-head">
    <div>
        <h1>New branch</h1>
        <p>Set up a location. Its menu link is ready the moment you save.</p>
    </div>
</header>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <partial name="_BranchForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
