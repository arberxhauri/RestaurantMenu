@using Microsoft.AspNetCore.Mvc.Rendering
@using RestaurantMenu.Helpers
@model Branch
@{
    var isEdit = Model?.Id > 0;
    var selected = ViewBag.SelectedLanguages as string[]
                   ?? (Model?.SupportedLanguages?.Split(',', StringSplitOptions.RemoveEmptyEntries))
                   ?? new[] { "en" };
    var hours = ViewBag.Hours as List<OpeningHours.FormDay> ?? OpeningHours.ToForm(null);
    var hourErrors = ViewData.ModelState.TryGetValue("Hours", out var hourState) ? hourState.Errors.Select(e => e.ErrorMessage).ToList() : new List<string>();
    var brand = ViewBag.Brand as BrandTheme ?? BrandTheme.Parse(Model?.ThemeColors);
    var brandErrors = ViewData.ModelState.TryGetValue("Brand", out var brandState) ? brandState.Errors.Select(e => e.ErrorMessage).ToList() : new List<string>();
    var hasLogoColours = brand.LogoPrimary != null;
    var colourFields = new[]
    {
        (Key: "primary", Label: "Main colour", Hint: "Buttons, prices, the selected category", Value: brand.Primary, Logo: brand.LogoPrimary),
        (Key: "secondary", Label: "Second colour", Hint: "Blends with the main colour in the header", Value: brand.Secondary, Logo: brand.LogoSecondary),
        (Key: "accent", Label: "Highlight colour", Hint: "Badges like Chef's pick and New", Value: brand.Accent, Logo: brand.LogoAccent)
    };
}

<div class="form-layout">
    <div class="panel">
        <div asp-validation-summary="ModelOnly" class="m-4 mb-0"></div>

        <section class="form-section">
            <h2>Details</h2>
            <p>Shown at the top of the guest menu.</p>
            <div class="fields">
                <div class="span-2">
                    <label asp-for="Name" class="form-label">Branch name</label>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Oliva Kitchen Blloku…" autocomplete="organization" />
                    @if (string.IsNullOrEmpty(Model?.Slug))
                    {
                        <span class="hint">Also forms the menu link, e.g. /menu/oliva-kitchen-blloku</span>
                    }
                    else
                    {
                        <span class="hint">Menu link: /menu/@Model.Slug. A new name can change it; the old link and printed QR codes keep working.</span>
                    }
                    <span asp-validation-for="Name"></span>
                </div>
                <div class="span-2">
                    <label asp-for="Address" class="form-label">Address</label>
                    <input asp-for="Address" class="form-control" placeholder="Rruga Pjetër Bogdani 12, Tiranë…" autocomplete="street-address" />
                    <span class="hint">Guests can tap it to open directions.</span>
                    <span asp-validation-for="Address"></span>
                </div>
                <div>
                    <label asp-for="PhoneNumber" class="form-label">Phone</label>
                    <input asp-for="PhoneNumber" class="form-control" type="tel" inputmode="tel" placeholder="+355 69 482 7716…" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber"></span>
                </div>
                <div>
                    <label asp-for="Currency" class="form-label">Currency</label>
                    <select asp-for="Currency" asp-items="ViewBag.Currencies" class="form-select">
                        <option value="">Choose a currency</option>
                    </select>
                    <span asp-validation-for="Currency"></span>
                </div>
            </div>
        </section>

        <section class="form-section">
            <h2>Menu languages</h2>
            <p>Guests can switch between these. You'll be asked for a translation of each dish.</p>
            <div class="lang-chips" role="group" aria-label="Menu languages">
                @foreach (var language in LanguageHelper.GetAvailableLanguages())
                {
                    <label class="lang-chip">
                        <input type="checkbox" name="selectedLanguages" value="@language.Value" @(selected.Contains(language.Value) ? "checked" : "") />
                        <span>@language.Text</span>
                    </label>
                }
            </div>
        </section>

        <section class="form-section brand" data-brand>
            <h2>Brand</h2>
            <p>How your menu looks to guests. The colours start from your logo; adjust them to match your brand.</p>
            @if (brandErrors.Any())
            {
                <ul class="hours-errors" role="alert">
                    @foreach (var e in brandErrors)
                    {
                        <li>@e</li>
                    }
                </ul>
            }
            <div class="brand-grid">
                <div class="brand-controls">
                    @foreach (var c in colourFields)
                    {
                        <div class="brand-color">
                            <input type="color" class="brand-swatch" id="brand-@c.Key" value="@c.Value.ToLowerInvariant()" data-brand-picker="@c.Key" aria-label="@c.Label" />
                            <div class="brand-color-text">
                                <label class="form-label mb-0" for="brand-@c.Key-hex">@c.Label</label>
                                <span class="hint mt-0">@c.Hint</span>
                            </div>
                            <input type="text" class="form-control form-control-sm mono brand-hex" id="brand-@c.Key-hex" name="brand_@c.Key" value="@c.Value"
                                   maxlength="7" spellcheck="false" autocomplete="off" data-brand-hex="@c.Key" data-logo="@c.Logo" />
                            <input type="hidden" name="brand_shown_@c.Key" value="@c.Value" />
                        </div>
                    }
                    @if (hasLogoColours)
                    {
                        <button type="button" class="btn btn-quiet btn-sm brand-reset" data-brand-reset>
                            <i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>Use logo colours
                        </button>
                    }

                    <fieldset class="brand-choice">
                        <legend class="form-label">Header</legend>
                        @foreach (var (value, label, hint, icon) in new[] {
                            ("photo", "Photo", "Your banner photo", "ph-image"),
                            ("colour", "Colour", "Your colours, no photo", "ph-palette"),
                            ("minimal", "Minimal", "Compact and plain", "ph-text-aa") })
                        {
                            <label class="brand-option">
                                <input type="radio" name="brand_header" value="@value" @(brand.Header == value ? "checked" : "") />
                                <span><i class="ph @icon" aria-hidden="true"></i><strong>@label</strong><small>@hint</small></span>
                            </label>
                        }
                    </fieldset>
                    @if (string.IsNullOrEmpty(Model?.Banner))
                    {
                        <span class="hint brand-banner-hint" data-brand-photo-hint>No banner yet: "Photo" shows your colours until you add one.</span>
                    }

                    <fieldset class="brand-choice">
                        <legend class="form-label">Light or dark</legend>
                        @foreach (var (value, label, hint, icon) in new[] {
                            ("auto", "Automatic", "Follows the guest's phone", "ph-circle-half"),
                            ("light", "Always light", "", "ph-sun"),
                            ("dark", "Always dark", "", "ph-moon") })
                        {
                            <label class="brand-option">
                                <input type="radio" name="brand_appearance" value="@value" @(brand.Appearance == value ? "checked" : "") />
                                <span><i class="ph @icon" aria-hidden="true"></i><strong>@label</strong>@if (hint.Length > 0) { <small>@hint</small> }</span>
                            </label>
                        }
                    </fieldset>

                    <ul class="brand-notes" data-brand-notes aria-live="polite">
                        @foreach (var note in brand.ContrastNotes())
                        {
                            <li>@note</li>
                        }
                    </ul>
                </div>

            </div>
        </section>

        <section class="form-section">
            <h2>Sold-out dishes</h2>
            <p>Mark a dish sold out with the switch on its row. Choose what guests see meanwhile.</p>
            <div class="form-check form-switch">
                <input asp-for="HideSoldOut" class="form-check-input" role="switch" />
                <label asp-for="HideSoldOut" class="form-check-label">Hide sold-out dishes from the menu</label>
            </div>
            <span class="hint">Off: guests still see the dish, greyed out with a "Sold out" label. On: it disappears until you switch it back.</span>
        </section>

        <section class="form-section hours" data-hours>
            <h2>Opening hours</h2>
            <p>Guests see "Open until 23:00" or "Closed · opens 08:00" on the menu, and Google can show the hours in search and Maps.</p>
            @if (hourErrors.Any())
            {
                <ul class="hours-errors" role="alert">
                    @foreach (var e in hourErrors)
                    {
                        <li>@e</li>
                    }
                </ul>
            }
            <div class="form-check form-switch mb-3">
                <input asp-for="HoursEnabled" class="form-check-input" role="switch" />
                <label asp-for="HoursEnabled" class="form-check-label">Show opening hours on the menu</label>
            </div>

            <div class="hours-body">
                <div class="hours-zone">
                    <label asp-for="TimeZone" class="form-label">Time zone</label>
                    <select asp-for="TimeZone" class="form-select" asp-items="@(OpeningHours.TimeZones.Select(z => new SelectListItem(z.Label, z.Id)))"></select>
                </div>

                <div class="hours-grid" role="group" aria-label="Opening hours by day">
                    @foreach (var day in hours)
                    {
                        var dayName = day.Day.ToString();
                        string N(string part) => OpeningHours.FieldName(day.Day, part);
                        <div class="hours-row" data-hours-row>
                            <span class="hours-day">@dayName</span>
                            <label class="hours-closed">
                                <input type="checkbox" class="form-check-input" name="@N("closed")" value="true" @(day.Closed ? "checked" : "") />
                                Closed
                            </label>
                            <div class="hours-periods">
                                <span class="hours-range">
                                    <input type="time" class="form-control form-control-sm" name="@N("open1")" value="@day.Open1" aria-label="@dayName opens" />
                                    <span aria-hidden="true">–</span>
                                    <input type="time" class="form-control form-control-sm" name="@N("close1")" value="@day.Close1" aria-label="@dayName closes" />
                                </span>
                                <span class="hours-range" data-second @(day.HasSecond ? "" : "hidden")>
                                    <input type="time" class="form-control form-control-sm" name="@N("open2")" value="@day.Open2" aria-label="@dayName opens again" />
                                    <span aria-hidden="true">–</span>
                                    <input type="time" class="form-control form-control-sm" name="@N("close2")" value="@day.Close2" aria-label="@dayName closes again" />
                                    <button type="button" class="icon-btn icon-btn--sm" data-remove-second aria-label="Remove @dayName's second period" title="Remove"><i class="ph ph-x" aria-hidden="true"></i></button>
                                </span>
                                <button type="button" class="btn btn-quiet btn-sm hours-add" data-add-second @(day.HasSecond ? "hidden" : "")>
                                    <i class="ph ph-plus" aria-hidden="true"></i>Second period
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="hours-foot">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-copy-first-day>
                        <i class="ph ph-copy" aria-hidden="true"></i>Copy Monday to all days
                    </button>
                    <span class="hint m-0">Past midnight: enter e.g. 18:00 – 02:00. The same opening and closing time means open 24 hours. Use a second period for a lunch and a dinner service.</span>
                </div>
            </div>
        </section>
    </div>

    <aside class="form-aside">
        <div class="panel form-section">
            <h2>Logo</h2>
            <p>Square works best. Menu colours are taken from it.</p>
            <label class="dropzone dropzone--square dropzone--logo-fit" for="logo" data-dropzone="logo" data-current="@Model?.Logo" tabindex="0">
                <i class="ph ph-image-square" aria-hidden="true"></i>
                <strong>@(string.IsNullOrEmpty(Model?.Logo) ? "Upload logo" : "Replace logo")</strong>
                <small>Drop an image or click to browse</small>
                <button type="button" class="icon-btn icon-btn--sm dropzone-clear" aria-label="Undo logo change"><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i></button>
            </label>
            <input type="file" name="logo" id="logo" class="visually-hidden" accept="image/*" />
        </div>
        <div class="panel form-section">
            <h2>Banner</h2>
            <p>A wide photo of your room or a signature dish. 16:9 is ideal.</p>
            <label class="dropzone dropzone--wide" for="banner" data-dropzone="banner" data-current="@Model?.Banner" tabindex="0">
                <i class="ph ph-image" aria-hidden="true"></i>
                <strong>@(string.IsNullOrEmpty(Model?.Banner) ? "Upload banner" : "Replace banner")</strong>
                <small>Drop an image or click to browse</small>
                <button type="button" class="icon-btn icon-btn--sm dropzone-clear" aria-label="Undo banner change"><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i></button>
            </label>
            <input type="file" name="banner" id="banner" class="visually-hidden" accept="image/*" />
        </div>
        @* Live preview of the Brand section: same phone frame as the landing page (device.css), driven by site.js. *@
        <div class="panel form-section brand-preview" data-brand-preview-panel>
            <h2>Preview</h2>
            <p>How guests see your menu with these settings.</p>
            <div class="brand-preview-modes" role="group" aria-label="Preview">
                <button type="button" data-preview-mode="light" aria-pressed="true">Light</button>
                <button type="button" data-preview-mode="dark" aria-pressed="false">Dark</button>
            </div>
            <div class="device brand-device" aria-hidden="true">
                <div class="device-screen">
                    <div class="bp" data-brand-preview data-banner="@Model?.Banner">
                        <div class="bp-hero">
                            @if (!string.IsNullOrEmpty(Model?.Banner))
                            {
                                <img class="bp-hero-img" src="@Model.Banner" alt="" />
                            }
                            <div class="bp-hero-content">
                                @if (!string.IsNullOrEmpty(Model?.Logo))
                                {
                                    <img class="bp-logo" src="@Model.Logo" alt="" />
                                }
                                else
                                {
                                    <span class="bp-logo bp-logo--initial" data-bp-initial>@((Model?.Name ?? "R").Substring(0, 1))</span>
                                }
                                <span class="bp-name" data-bp-name>@(string.IsNullOrEmpty(Model?.Name) ? "Your restaurant" : Model.Name)</span>
                                <span class="bp-chips"><span>Address</span><span>Phone</span></span>
                            </div>
                        </div>
                        <div class="bp-body">
                            <div class="bp-cats"><span class="is-active">Mains</span><span>Desserts</span></div>
                            <div class="bp-item">
                                <span class="bp-text"><span class="bp-badge">Chef's pick</span><strong>Margherita</strong><small>Tomato, mozzarella, basil</small><span class="bp-price">€9.50</span></span>
                                <span class="bp-add is-on">✓</span>
                            </div>
                            <div class="bp-item">
                                <span class="bp-text"><strong>Tagliata</strong><small>Rocket, parmesan</small><span class="bp-price">€16.00</span></span>
                                <span class="bp-add">+</span>
                            </div>
                            <div class="bp-fab"><span>1</span> Your list <span>€9.50</span></div>
                        </div>
                    </div>
                </div>
                <div class="device-frame"></div>
            </div>
        </div>
    </aside>
</div>

<div class="form-actions">
    <span class="spacer">@(isEdit ? "Changes go live on the menu as soon as you save." : "You can change everything later.")</span>
    <a asp-controller="@(isEdit ? "Branch" : "Dashboard")" asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@(isEdit ? Model!.Id : (int?)null)" class="btn btn-quiet">Cancel</a>
    <button type="submit" class="btn btn-primary">
        <i class="ph ph-check" aria-hidden="true"></i>@(isEdit ? "Save changes" : "Create branch")
    </button>
</div>
